<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dataverse runs plug-ins on .NET Framework 4.6.2 in a sandbox; the assembly must be strong-name signed. -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MGLab.Plugins</AssemblyName>
    <RootNamespace>MGLab.Plugins</RootNamespace>
    <SignAssembly Condition="Exists('MGLab.Plugins.snk')">true</SignAssembly>
    <AssemblyOriginatorKeyFile>MGLab.Plugins.snk</AssemblyOriginatorKeyFile>
    <Version>1.0.1.0</Version>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
