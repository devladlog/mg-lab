{
  "displayName": "M365 Apps Pulse Responses",
  "description": "Responses of the Microsoft 365 Apps rollout pulse form, written by a Power Automate flow.",
  "columns": [
    {
      "name": "ResponseId",
      "displayName": "ResponseId",
      "description": "Forms response id (the trigger's Response Id)",
      "required": true,
      "indexed": true,
      "enforceUniqueValues": true,
      "number": {
        "decimalPlaces": "none"
      }
    },
    {
      "name": "Responder",
      "displayName": "Responder",
      "description": "Responders' Email from Get response details (empty when the response is anonymous)",
      "text": {
        "maxLength": 255
      }
    },
    {
      "name": "Submitted",
      "displayName": "Submitted",
      "description": "Submission time from Get response details",
      "dateTime": {
        "format": "dateTime",
        "displayAs": "default"
      }
    },
    {
      "name": "Department",
      "displayName": "Department",
      "description": "Which department are you in?",
      "required": true,
      "choice": {
        "allowTextEntry": false,
        "displayAs": "dropDownMenu",
        "choices": [
          "Finance",
          "Sales",
          "IT",
          "Operations"
        ]
      }
    },
    {
      "name": "Rating",
      "displayName": "Rating",
      "description": "How was the Microsoft 365 Apps rollout? (1 = bad, 5 = great)",
      "required": true,
      "number": {
        "decimalPlaces": "none",
        "minimum": 1.0,
        "maximum": 5.0
      }
    },
    {
      "name": "AppIssue",
      "displayName": "AppIssue",
      "description": "Which apps gave you trouble?",
      "choice": {
        "allowTextEntry": false,
        "displayAs": "checkBoxes",
        "choices": [
          "Word",
          "Excel",
          "Outlook",
          "PowerPoint",
          "Teams",
          "None"
        ]
      }
    },
    {
      "name": "Comment",
      "displayName": "Comment",
      "description": "Tell us more",
      "text": {
        "allowMultipleLines": true,
        "textType": "plain",
        "maxLength": 1000
      }
    },
    {
      "name": "ContactMe",
      "displayName": "ContactMe",
      "description": "May we contact you?",
      "boolean": {}
    },
    {
      "name": "IncidentDate",
      "displayName": "IncidentDate",
      "description": "When did it happen?",
      "dateTime": {
        "format": "dateOnly",
        "displayAs": "default"
      }
    }
  ],
  "list": {
    "template": "genericList"
  }
}
