<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline KQL check for the hunting queries: parses and binds them against the EmailEvents schema
       (columns from the Defender XDR advanced hunting reference) with Microsoft's Kusto.Language parser. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Kusto.Language" Version="12.*" />
  </ItemGroup>
</Project>
