{
  "directory": {
    "ignoreAccounts": [
      "krbtgt",
      "Guest",
      "Administrator"
    ],
    "upnFix": {
      "allowedRules": [
        "UpnNonRoutable"
      ],
      "targetSuffix": "contoso.onmicrosoft.com"
    }
  },
  "waves": {
    "maxMailboxesPerWave": 3,
    "maxGBPerWave": 20,
    "largeMailboxGB": 40,
    "badItemLimit": 0,
    "largeItemLimit": 0
  },
  "batch": {
    "sourceEndpointName": "<your-onprem-endpoint>",
    "targetDeliveryDomain": "<tenant>.mail.onmicrosoft.com"
  }
}