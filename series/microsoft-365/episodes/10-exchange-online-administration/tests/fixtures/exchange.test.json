{
  "forwarding": {
    "allowedExternalDomains": [],
    "ignoreMailboxes": [
      "emergency.access@contoso.com"
    ]
  },
  "transportRules": {
    "requireComment": true
  },
  "outboundSpam": {
    "flagModes": [
      "On",
      "Automatic"
    ]
  },
  "sharedMailbox": {
    "limitGb": 50,
    "warnPercent": 90,
    "requireSignInBlocked": true
  },
  "fullAccess": {
    "maxDelegatesPerMailbox": 10
  },
  "quota": {
    "warnPercent": 90
  },
  "trace": {
    "defaultHours": 48,
    "maxDays": 10
  },
  "provision": {
    "retryCount": 3,
    "retrySeconds": 5
  },
  "fix": {
    "allowedRules": [
      "MailboxForwardingExternal"
    ]
  }
}