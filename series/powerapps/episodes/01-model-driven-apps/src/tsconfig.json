{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node", "xrm"],
    "skipLibCheck": true
  },
  "include": ["model/**/*.ts", "provision/**/*.ts", "formscripts/**/*.ts", "tests/**/*.ts"]
}
