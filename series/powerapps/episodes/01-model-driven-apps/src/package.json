{
  "name": "contoso-equipment-desk",
  "version": "1.0.0",
  "private": true,
  "description": "Model-driven app 'Equipment Desk': Dataverse provisioning (Web API) + a TypeScript form script",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "build": "esbuild formscripts/loanForm.ts --bundle --format=iife --global-name=Contoso.LoanForm --target=es2020 --outfile=dist/contoso_/scripts/loanform.js",
    "plan": "node provision/provision.ts --dry-run",
    "provision": "node provision/provision.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/xrm": "^9.0.97",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
