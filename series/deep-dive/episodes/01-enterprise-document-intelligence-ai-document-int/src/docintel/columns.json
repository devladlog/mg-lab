{
  "_comment": "Single contract shared by the function (response keys), the PnP provisioning script (library columns) and the flow (Update file properties). Change it here, nowhere else.",
  "library": "Invoices Inbox",
  "columns": [
    {"internalName": "InvVendor",     "displayName": "Vendor",          "type": "Text",     "source": "VendorName"},
    {"internalName": "InvNumber",     "displayName": "Invoice number",  "type": "Text",     "source": "InvoiceId"},
    {"internalName": "InvDate",       "displayName": "Invoice date",    "type": "DateTime", "source": "InvoiceDate"},
    {"internalName": "InvDueDate",    "displayName": "Due date",        "type": "DateTime", "source": "DueDate"},
    {"internalName": "InvPO",         "displayName": "Purchase order",  "type": "Text",     "source": "PurchaseOrder"},
    {"internalName": "InvSubTotal",   "displayName": "Subtotal",        "type": "Number",   "source": "SubTotal"},
    {"internalName": "InvTax",        "displayName": "Tax",             "type": "Number",   "source": "TotalTax"},
    {"internalName": "InvTotal",      "displayName": "Total",           "type": "Number",   "source": "InvoiceTotal"},
    {"internalName": "InvCurrency",   "displayName": "Currency",        "type": "Text",     "source": "InvoiceTotal.currency"},
    {"internalName": "InvConfidence", "displayName": "Confidence",      "type": "Number",   "source": "computed"},
