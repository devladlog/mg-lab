  "definitions": {
    "SubmitRequest": {
      "type": "object",
      "required": [
        "title",
        "justification",
        "amount",
        "currency"
      ],
      "properties": {
        "title": {
          "type": "string",
          "x-ms-summary": "Title"
        },
        "justification": {
          "type": "string",
          "x-ms-summary": "Justification"
        },
        "amount": {
          "type": "number",
          "format": "double",
          "x-ms-summary": "Amount"
        },
        "currency": {
          "type": "string",
          "x-ms-summary": "Currency",
          "default": "EUR"
        }
      }
    },
    "DecisionRequest": {
      "type": "object",
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "Approve",
            "Reject"
          ],
          "x-ms-summary": "Outcome"
        },
        "comment": {
          "type": "string",
          "x-ms-summary": "Comment"
        }
      }
    },
    "RequestView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "justification": {
          "type": "string"
        },
        "amount": {
          "type": "number",
          "format": "double"
        },
        "currency": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "Pending",
            "Approved",
            "Rejected"
          ]
        },
        "requestedByName": {
          "type": "string"
        },
        "createdAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "decidedByName": {
          "type": "string",
          "x-nullable": true
        },
        "decidedAtUtc": {
          "type": "string",
          "format": "date-time",
          "x-nullable": true
        },
        "decisionComment": {
          "type": "string",
          "x-nullable": true
        }
      }
    },
    "AuditView": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "actorOid": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "atUtc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Problem": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        },
        "detail": {
          "type": "string"
        },
        "errors": {
          "type": "object"
        }
      }
    }
  },
