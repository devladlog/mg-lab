{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": { "isEnabled": true, "excludedTypes": "Request" }
    }
  },
  "extensions": {
    "durableTask": {
      "hubName": "InvoiceApprovals",
      "storageProvider": {
        "maxQueuePollingInterval": "00:00:10"
      }
    },
    "serviceBus": {
      "maxConcurrentCalls": 4
    }
  }
}
