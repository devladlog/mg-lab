{
  "_comment": "Columns this episode adds to the episode 1 library. The PnP script creates them, the relay flow writes them, tests check both against the code.",
  "library": "Invoices Inbox",
  "readsFromEpisode1": ["ID", "InvDedupKey", "InvVendor", "InvNumber", "InvTotal", "InvCurrency", "InvStatus", "Author", "{Link}"],
  "columns": [
    {"internalName": "InvApprovalStatus",   "displayName": "Approval status",   "type": "Choice",
     "choices": ["Not started", "Waiting for approval", "Approved", "Rejected", "Expired"], "default": "Not started"},
    {"internalName": "InvApprovalWith",     "displayName": "Approval step",     "type": "Text"},
    {"internalName": "InvApprovedBy",       "displayName": "Decided by",        "type": "Text"},
    {"internalName": "InvApprovalNote",     "displayName": "Approval summary",  "type": "Note"},
    {"internalName": "InvApprovalInstance", "displayName": "Approval instance", "type": "Text"}
  ]
}
