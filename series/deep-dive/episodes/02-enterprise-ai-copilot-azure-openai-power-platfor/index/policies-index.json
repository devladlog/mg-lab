{
  "name": "hr-policies",
  "fields": [
    {"name": "id", "type": "Edm.String", "key": true, "filterable": true, "retrievable": true},
    {"name": "title", "type": "Edm.String", "searchable": true, "retrievable": true},
    {"name": "url", "type": "Edm.String", "retrievable": true},
    {"name": "chunk", "type": "Edm.String", "searchable": true, "retrievable": true, "analyzer": "en.microsoft"},
    {"name": "content_vector", "type": "Collection(Edm.Single)", "searchable": true, "retrievable": false,
     "stored": false, "dimensions": 1536, "vectorSearchProfile": "vector-profile"},
    {"name": "group_ids", "type": "Collection(Edm.String)", "filterable": true, "retrievable": false},
    {"name": "source_item", "type": "Edm.String", "filterable": true, "retrievable": false},
    {"name": "source_modified", "type": "Edm.DateTimeOffset", "filterable": true, "retrievable": true}
  ],
  "vectorSearch": {
    "algorithms": [{"name": "hnsw", "kind": "hnsw", "hnswParameters": {"metric": "cosine"}}],
    "profiles": [{"name": "vector-profile", "algorithm": "hnsw", "vectorizer": "aoai-embeddings"}],
    "vectorizers": [{
      "name": "aoai-embeddings",
      "kind": "azureOpenAI",
      "azureOpenAIParameters": {
        "resourceUri": "${OPENAI_ENDPOINT}",
        "deploymentId": "embed",
        "modelName": "text-embedding-3-small"
      }
    }]
  }
}
