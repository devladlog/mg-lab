{
  "_comment": "The two SharePoint lists of the onboarding portal. The PnP script creates them, the canvas app and the approval flow write them, the function reads and writes them. Tests check all four against this file.",
  "site": "/sites/hr-lab",
  "statuses": {
    "submitted": "Submitted",
    "approved": "Approved",
    "rejected": "Rejected",
    "sent": "Sent to Entra",
    "created": "Account created",
    "failed": "Failed"
  },
  "lists": [
    {
      "title": "Onboarding Requests",
      "description": "One item per new hire. HR submits it in the canvas app, the hiring manager approves it, the provisioning function sends it to Microsoft Entra.",
      "columns": [
        {"internalName": "OnbGivenName",     "displayName": "Given name",        "type": "Text", "required": true},
        {"internalName": "OnbSurname",       "displayName": "Surname",           "type": "Text", "required": true},
        {"internalName": "OnbDepartment",    "displayName": "Department",        "type": "Choice", "choices": ["Sales", "Finance", "Operations", "IT"], "required": true},
        {"internalName": "OnbJobTitle",      "displayName": "Job title",         "type": "Text", "required": true},
        {"internalName": "OnbManagerEmail",  "displayName": "Hiring manager",    "type": "Text", "required": true},
        {"internalName": "OnbStartDate",     "displayName": "Start date",        "type": "DateOnly", "required": true},
        {"internalName": "OnbUsageLocation", "displayName": "Usage location",    "type": "Text", "default": "PT"},
        {"internalName": "OnbStatus",        "displayName": "Status",            "type": "Choice", "indexed": true,
         "choices": ["Submitted", "Approved", "Rejected", "Sent to Entra", "Account created", "Failed"], "default": "Submitted"},
        {"internalName": "OnbEmployeeId",    "displayName": "Employee ID",       "type": "Text"},
        {"internalName": "OnbUpn",           "displayName": "Sign-in name",      "type": "Text"},
        {"internalName": "OnbObjectId",      "displayName": "Entra object ID",   "type": "Text"},
        {"internalName": "OnbSentAt",        "displayName": "Sent to Entra at",  "type": "DateTime"},
        {"internalName": "OnbMessage",       "displayName": "Provisioning note", "type": "Note"}
      ]
    },
    {
      "title": "Onboarding Tasks",
      "description": "Day-one checklist, generated by the function from config/task-templates.json when the account exists.",
      "columns": [
        {"internalName": "OnbRequestId", "displayName": "Request ID", "type": "Number", "indexed": true, "required": true},
        {"internalName": "OnbTaskKey",   "displayName": "Task key",   "type": "Text", "required": true},
        {"internalName": "OnbOwnerRole", "displayName": "Owner",      "type": "Choice", "choices": ["HR", "Manager", "IT", "New hire"], "required": true},
        {"internalName": "OnbOwnerEmail","displayName": "Owner email","type": "Text"},
        {"internalName": "OnbDueDate",   "displayName": "Due date",   "type": "DateOnly", "required": true},
        {"internalName": "OnbDone",      "displayName": "Done",       "type": "Boolean", "default": "0"}
      ]
    }
  ]
}
