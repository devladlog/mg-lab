<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AnalysisServices" Version="19.120.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- the model under test: the TMDL folder is copied next to the test binaries -->
    <Content Include="../../model/ContosoReporting.SemanticModel/**/*.*" LinkBase="model" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
