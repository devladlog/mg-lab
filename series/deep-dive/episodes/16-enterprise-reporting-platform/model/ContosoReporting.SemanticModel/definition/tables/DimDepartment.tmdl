/// One row per department. The row-level security role filters this table, and the filter flows to the facts.
table DimDepartment

	column DepartmentKey
		dataType: string
		isKey
		sourceColumn: DepartmentKey
		summarizeBy: none

	column DepartmentName
		dataType: string
		sourceColumn: DepartmentName
		summarizeBy: none

	partition DimDepartment = m
		mode: import
		source =
				let
				    Source = Sql.Database(SynapseServer, SynapseDatabase),
				    Dim = Source{[Schema = "gold", Item = "DimDepartment"]}[Data]
				in
				    Dim
