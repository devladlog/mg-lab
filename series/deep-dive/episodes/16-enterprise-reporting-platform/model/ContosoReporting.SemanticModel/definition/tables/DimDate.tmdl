/// Contiguous calendar built in the model, from 1 January of the first year to 31 December of the last year with data.
table DimDate
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		isNameInferred
		sourceColumn: [Date]
		summarizeBy: none

	column Year
		dataType: int64
		formatString: 0
		isNameInferred
		sourceColumn: [Year]
		summarizeBy: none

	column MonthNumber
		dataType: int64
		formatString: 0
		isNameInferred
		sourceColumn: [MonthNumber]
		summarizeBy: none

	column Month
		dataType: string
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: MonthNumber
		summarizeBy: none

	partition DimDate = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(
				        DATE(YEAR(MIN(FactPurchaseRequest[SubmittedDate])), 1, 1),
				        DATE(YEAR(MAX(FactPurchaseRequest[SubmittedDate])), 12, 31)),
				    "Year", YEAR([Date]),
				    "MonthNumber", MONTH([Date]),
				    "Month", FORMAT([Date], "mmm"))
