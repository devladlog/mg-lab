/// Serverless SQL endpoint of the episode 15 workspace, for example <workspace>-ondemand.sql.azuresynapse.net. Set it per stage with a deployment rule.
expression SynapseServer = "REPLACE-WITH-SERVERLESS-ENDPOINT" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

/// Database created by episode 15.
expression SynapseDatabase = "contoso_analytics" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

/// Domain part of the lab users, used to build the row-level security mapping. Fictional users only.
expression UpnDomain = "REPLACE-WITH-LAB-DOMAIN" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
