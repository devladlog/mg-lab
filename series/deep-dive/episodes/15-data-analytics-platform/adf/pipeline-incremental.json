{
  "description": "Incremental copy of dbo.PurchaseRequests to the lake as Parquet (bronze), watermark kept in etl.Watermark. Pattern: Learn, 'Incrementally load data from Azure SQL Database to Azure Blob storage'.",
  "parameters": {
    "TableName": { "type": "string", "defaultValue": "dbo.PurchaseRequests" }
  },
  "activities": [
    {
      "name": "LookupOldWatermark",
      "type": "Lookup",
      "policy": { "timeout": "0.00:10:00", "retry": 3, "retryIntervalInSeconds": 60 },
      "typeProperties": {
        "source": {
          "type": "AzureSqlSource",
          "sqlReaderQuery": "SELECT WatermarkValue FROM etl.Watermark WHERE TableName = '@{pipeline().parameters.TableName}'"
        },
        "dataset": { "referenceName": "ds_source_sql", "type": "DatasetReference" },
        "firstRowOnly": true
      }
    },
    {
      "name": "LookupNewWatermark",
      "type": "Lookup",
      "policy": { "timeout": "0.00:10:00", "retry": 3, "retryIntervalInSeconds": 60 },
      "typeProperties": {
        "source": {
          "type": "AzureSqlSource",
          "sqlReaderQuery": "SELECT COALESCE(MAX(ModifiedOn), (SELECT WatermarkValue FROM etl.Watermark WHERE TableName = '@{pipeline().parameters.TableName}')) AS NewWatermark FROM dbo.PurchaseRequests"
        },
        "dataset": { "referenceName": "ds_source_sql", "type": "DatasetReference" },
        "firstRowOnly": true
      }
    },
    {
      "name": "CopyDeltaToBronze",
      "type": "Copy",
      "dependsOn": [
        { "activity": "LookupOldWatermark", "dependencyConditions": ["Succeeded"] },
        { "activity": "LookupNewWatermark", "dependencyConditions": ["Succeeded"] }
      ],
      "policy": { "timeout": "0.00:30:00", "retry": 1, "retryIntervalInSeconds": 30 },
      "typeProperties": {
        "source": {
          "type": "AzureSqlSource",
          "sqlReaderQuery": "SELECT RequestId, DepartmentCode, Category, VendorName, Amount, Currency, Status, SubmittedOn, ApprovedOn, ModifiedOn FROM dbo.PurchaseRequests WHERE ModifiedOn > '@{activity('LookupOldWatermark').output.firstRow.WatermarkValue}' AND ModifiedOn <= '@{activity('LookupNewWatermark').output.firstRow.NewWatermark}'"
        },
        "sink": {
          "type": "ParquetSink",
          "storeSettings": { "type": "AzureBlobFSWriteSettings" },
          "formatSettings": { "type": "ParquetWriteSettings" }
        },
        "enableStaging": false
      },
      "inputs": [ { "referenceName": "ds_source_sql", "type": "DatasetReference" } ],
      "outputs": [
        {
          "referenceName": "ds_bronze_parquet",
          "type": "DatasetReference",
          "parameters": {
            "FolderPath": "@concat('bronze/purchase_requests/ingest_date=', formatDateTime(utcNow(), 'yyyy-MM-dd'))",
            "FileName": "@concat('requests-', pipeline().RunId, '.parquet')"
          }
        }
      ]
    },
    {
      "name": "WriteWatermark",
      "type": "SqlServerStoredProcedure",
      "dependsOn": [ { "activity": "CopyDeltaToBronze", "dependencyConditions": ["Succeeded"] } ],
      "policy": { "timeout": "0.00:10:00", "retry": 3, "retryIntervalInSeconds": 60 },
      "linkedServiceName": { "referenceName": "ls_source_sql", "type": "LinkedServiceReference" },
      "typeProperties": {
        "storedProcedureName": "etl.usp_write_watermark",
        "storedProcedureParameters": {
          "TableName": { "value": "@{pipeline().parameters.TableName}", "type": "String" },
          "NewWatermark": { "value": "@{activity('LookupNewWatermark').output.firstRow.NewWatermark}", "type": "DateTime" }
        }
      }
    }
  ]
}
