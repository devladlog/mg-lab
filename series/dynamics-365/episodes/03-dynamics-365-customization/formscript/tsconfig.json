{
  // A form library is a classic script, not a module: no import/export, one global namespace (MGL),
  // one output file. That file is exactly what we upload as the web resource and what the tests run.
  "compilerOptions": {
    "target": "ES2019",
    "module": "none",
    "outFile": "dist/mgl_projectrequest_form.js",
    "lib": ["ES2019", "DOM"],
    "types": ["xrm"],
    "strict": true,
    "noImplicitReturns": true,
    "removeComments": false,
    "newLine": "lf"
  },
  "include": ["src/**/*.ts"]
}
