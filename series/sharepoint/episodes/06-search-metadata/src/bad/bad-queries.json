{
  "$comment": "Queries people really write, each with one KQL mistake: the KQL lint demo.",
  "tests": [
    { "name": "space after the colon",    "query": "PurchSupplier: \"Fabrikam\"" },
    { "name": "lowercase operator",       "query": "PurchSupplier:Fabrikam and PurchSupplier:Northwind" },
    { "name": "range on a text property", "query": "ExpiryDateOWSDATE<2027-01-01" },
    { "name": "date in local format",     "query": "PurchExpiry<31/12/2026" },
    { "name": "leading wildcard",         "query": "*voice" },
    { "name": "unknown property",         "query": "Supplier:Fabrikam" },
    { "name": "unclosed quote",           "query": "PurchSupplier:\"Northwind Traders" }
  ]
}
