{
  "library": "Supplier Documents",
  "folderContentType": "Supplier File",
  "rules": [
    { "name": "contract", "contentType": "Contract", "folder": "{Supplier}",
      "match": "^CTR-(?<ContractNumber>\\d{4}-\\d{4}) (?<Supplier>.+?)(?: until (?<ExpiryDate>\\d{4}-\\d{2}-\\d{2}))?\\.(txt|pdf|docx)$" },
    { "name": "invoice", "contentType": "Invoice", "folder": "{Supplier}",
      "match": "^INV-(?<InvoiceNumber>\\d+) (?<Supplier>.+?) (?<InvoiceDate>\\d{4}-\\d{2}-\\d{2})\\.(txt|pdf|docx)$" }
  ]
}
