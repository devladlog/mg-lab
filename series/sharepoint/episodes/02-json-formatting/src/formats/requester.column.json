{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "txtContent": "@currentField.title",
  "attributes": {
    "class": "=if(@me == @currentField.email, '', 'ms-fontColor-neutralSecondary')"
  },
  "style": {
    "font-weight": "=if(@me == @currentField.email, '600', '400')"
  }
}
