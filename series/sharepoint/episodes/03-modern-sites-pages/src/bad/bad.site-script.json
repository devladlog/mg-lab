{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/site-design-script-actions.schema.json",
  "actions": [
    { "verb": "setSiteLogo", "url": "/SiteAssets/logo.png" },
    { "verb": "setSiteBranding", "navigationLayout": "Megamenu", "headerLayout": "Compact" },
    { "verb": "setRegionalSettings", "timeZone": 2, "locale": 99999, "sortOrder": 25, "hourFormat": "24" },
    { "verb": "joinHubSite", "hubSiteId": "00000000-0000-0000-0000-000000000000" },
    { "verb": "createList", "listName": "Projects", "templateType": 100 },
    {
      "verb": "createSPList",
      "listName": "Project Tracker",
      "templateType": 171,
      "subactions": [
        { "verb": "setTitle", "title": "Projects 2026" },
        { "verb": "addSPField", "fieldType": "Text", "displayName": "Project Code", "isRequired": true },
        { "verb": "addSPFieldXml", "schemaXml": "<Field Type=\"Choice\" DisplayName=\"Phase\" Name=\"Phase\"><CHOICES><CHOICE>Plan</CHOICE><CHOICE>Build</CHOICE></CHOICES></Field>" },
        { "verb": "addSiteColumn", "internalName": "ProjectOwner" },
        { "verb": "addContentType", "name": "Project Brief" }
      ]
    }
  ]
}
