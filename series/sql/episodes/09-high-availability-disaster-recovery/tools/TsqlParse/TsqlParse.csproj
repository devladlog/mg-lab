<Project Sdk="Microsoft.NET.Sdk">

  <!-- Parses T-SQL files with Microsoft's own parser (ScriptDom, the one SSMS and SqlPackage use)
       and prints a JSON summary the Python tests check. Build: dotnet build -c Release -m:1 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="170.191.0" />
  </ItemGroup>

</Project>
