<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Contoso.Orders.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft OpenTelemetry Distro: ASP.NET Core + HttpClient + Azure SDK instrumentation, Azure Monitor exporter -->
    <PackageReference Include="Microsoft.OpenTelemetry" Version="1.2.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Contoso.Orders.Api.Tests" />
  </ItemGroup>

</Project>
