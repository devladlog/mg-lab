<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- dotnet publish -p Version=1.1.0 sets the image tag and what GET / reports -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Container image built by the .NET SDK: no Dockerfile, no Docker daemon.
       dotnet publish -c Release /t:PublishContainer -p ContainerArchiveOutputPath=...   (tarball, used by the tests)
       dotnet publish -c Release /t:PublishContainer -p ContainerRegistry=<acr>.azurecr.io (push, infra/push-image.sh) -->
  <PropertyGroup>
    <ContainerRepository>contoso/orders-api</ContainerRepository>
    <ContainerImageTag>$(Version)</ContainerImageTag>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ContainerLabel Include="org.opencontainers.image.source" Value="https://github.com/devladlog/mg-lab" />
    <ContainerLabel Include="org.opencontainers.image.title" Value="contoso-orders-api" />
  </ItemGroup>

</Project>
