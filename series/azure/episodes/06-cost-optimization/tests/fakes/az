#!/usr/bin/env python3
"""Fake Azure CLI for the tests: answers `az graph query` from JSON files, logs every call.
FAKE_AZ_DIR: folder with disks.json, pips.json, plans.json, vms.json, untagged.json, advisor.json
FAKE_AZ_LOG: append argv here (one JSON line per call)
FAKE_AZ_PAGED=1: the disk query comes back in two pages (skip_token)
FAKE_AZ_FAIL=1: exit 1 with an error like a missing login"""
import json, os, sys
from pathlib import Path

args = sys.argv[1:]
if os.environ.get("FAKE_AZ_LOG"):
    with open(os.environ["FAKE_AZ_LOG"], "a") as f:
        f.write(json.dumps(args) + "\n")
if os.environ.get("FAKE_AZ_FAIL"):
    print("ERROR: Please run 'az login' to setup account.", file=sys.stderr)
    sys.exit(1)
if args[:2] != ["graph", "query"]:
    print(f"fake az: unsupported command {args[:2]}", file=sys.stderr)
    sys.exit(2)
query = args[args.index("-q") + 1].lower()
pick = [("microsoft.compute/disks", "disks"), ("publicipaddresses", "pips"), ("serverfarms", "plans"),
        ("virtualmachines", "vms"), ("tags['workload']", "untagged"), ("advisorresources", "advisor")]
name = next(n for key, n in pick if key in query)
rows = json.loads((Path(os.environ["FAKE_AZ_DIR"]) / f"{name}.json").read_text())
skip = args[args.index("--skip-token") + 1] if "--skip-token" in args else None
if os.environ.get("FAKE_AZ_PAGED") and name == "disks":
    page = rows[1:] if skip == "page-2" else rows[:1]
    token = None if skip == "page-2" else "page-2"
else:
    page, token = rows, None
print(json.dumps({"count": len(page), "data": page, "skip_token": token, "total_records": len(rows)}))
