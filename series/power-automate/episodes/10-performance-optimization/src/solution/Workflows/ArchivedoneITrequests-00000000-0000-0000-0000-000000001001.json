{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "cts_sharedsharepointonline_ithousekeeping"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "cts_sharedoffice365_ithousekeeping"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "IT site URL (cts_ITSiteUrl)": {
          "defaultValue": "https://contoso.sharepoint.com/sites/ITHelpdesk",
          "type": "String",
          "metadata": {
            "schemaName": "cts_ITSiteUrl",
            "description": "Site that holds the IT Requests list"
          }
        },
        "IT Requests list (cts_ITRequestsList)": {
          "defaultValue": "IT Requests",
          "type": "String",
          "metadata": {
            "schemaName": "cts_ITRequestsList",
            "description": "Name of the IT Requests list"
          }
        },
        "Archive after days (cts_ArchiveAfterDays)": {
          "defaultValue": "30",
          "type": "String",
          "metadata": {
            "schemaName": "cts_ArchiveAfterDays",
            "description": "Days a request stays Done before it is archived"
          }
        },
        "Service desk mailbox (cts_ServiceDeskMailbox)": {
          "defaultValue": "servicedesk@contoso.com",
          "type": "String",
          "metadata": {
            "schemaName": "cts_ServiceDeskMailbox",
            "description": "Gets the nightly summary"
          }
        }
      },
      "triggers": {
        "Every_night_at_2": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "timeZone": "GMT Standard Time",
            "schedule": {
              "hours": [
                "2"
              ],
              "minutes": [
                0
              ]
            }
          }
        }
      },
      "actions": {
        "Cutoff": {
          "type": "Compose",
          "runAfter": {},
          "inputs": "@formatDateTime(addDays(utcNow(), mul(-1, int(parameters('Archive after days (cts_ArchiveAfterDays)')))), 'yyyy-MM-ddTHH:mm:ssZ')"
        },
        "Get_done_requests": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Cutoff": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 5000
            }
          },
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "parameters": {
              "dataset": "@parameters('IT site URL (cts_ITSiteUrl)')",
              "table": "@parameters('IT Requests list (cts_ITRequestsList)')",
              "$filter": "Status eq 'Done' and DoneOn lt '@{outputs('Cutoff')}'",
              "$top": 5000
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Any_to_archive": {
          "type": "If",
          "runAfter": {
            "Get_done_requests": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "greater": [
                  "@length(body('Get_done_requests')?['value'])",
                  0
                ]
              }
            ]
          },
          "actions": {
            "Apply_to_each": {
              "type": "Foreach",
              "runAfter": {},
              "foreach": "@body('Get_done_requests')?['value']",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 20
                }
              },
              "actions": {
                "Archive_item": {
                  "type": "OpenApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "@parameters('IT site URL (cts_ITSiteUrl)')",
                      "table": "@parameters('IT Requests list (cts_ITRequestsList)')",
                      "id": "@items('Apply_to_each')?['ID']",
                      "item/Title": "@items('Apply_to_each')?['Title']",
                      "item/Status/Value": "Archived"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              }
            },
            "Send_summary": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2"
                },
                "parameters": {
                  "emailMessage/To": "@parameters('Service desk mailbox (cts_ServiceDeskMailbox)')",
                  "emailMessage/Subject": "IT housekeeping: @{length(body('Get_done_requests')?['value'])} requests archived",
                  "emailMessage/Body": "<p>@{length(body('Get_done_requests')?['value'])} requests were Done for @{parameters('Archive after days (cts_ArchiveAfterDays)')} days or more and are now Archived.</p>",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Apply_to_each": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}