{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "cts_sharedsharepointonline_rpa"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "cts_sharedoffice365_rpa"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_uiflow": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "cts_shareduiflow_rpa"
        },
        "api": {
          "name": "shared_uiflow"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_purchase_request_is_approved": {
          "type": "OpenApiConnection",
          "recurrence": {
            "interval": 5,
            "frequency": "Minute"
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "conditions": [
            {
              "expression": "@and(equals(triggerBody()?['Status']?['Value'], 'Approved'), empty(triggerBody()?['RpaStatus']))"
            }
          ],
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnUpdatedItems"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/Purchasing",
              "table": "Purchase Requests"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Try": {
          "type": "Scope",
          "runAfter": {},
          "actions": {
            "Run_desktop_flow": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "limit": {
                "timeout": "PT30M"
              },
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_uiflow",
                  "connectionName": "shared_uiflow",
                  "operationId": "RunUIFlow_V2"
                },
                "parameters": {
                  "uiFlowId": "00000000-0000-0000-0000-000000000901",
                  "runMode": "attended",
                  "item/Supplier": "@triggerBody()?['Supplier']",
                  "item/Description": "@coalesce(triggerBody()?['Justification'], triggerBody()?['Title'])",
                  "item/Amount": "@formatNumber(triggerBody()?['Amount'], '0.00', 'en-US')",
                  "item/RequestId": "@string(triggerBody()?['ID'])"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          }
        },
        "Order_saved": {
          "type": "If",
          "runAfter": {
            "Try": [
              "Succeeded"
            ]
          },
          "expression": {
            "equals": [
              "@outputs('Run_desktop_flow')?['body/Status']",
              "Saved"
            ]
          },
          "actions": {
            "Mark_entered": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem"
                },
                "parameters": {
                  "dataset": "https://contoso.sharepoint.com/sites/Purchasing",
                  "table": "Purchase Requests",
                  "id": "@triggerBody()?['ID']",
                  "item/Title": "@triggerBody()?['Title']",
                  "item/RpaStatus": "Entered",
                  "item/PONumber": "@outputs('Run_desktop_flow')?['body/OrderNumber']"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Tell_requester_entered": {
              "type": "OpenApiConnection",
              "runAfter": {
                "Mark_entered": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2"
                },
                "parameters": {
                  "emailMessage/To": "@triggerBody()?['Author']?['Email']",
                  "emailMessage/Subject": "Ordered: @{triggerBody()?['Title']}",
                  "emailMessage/Body": "<p>Your request was entered as order @{outputs('Run_desktop_flow')?['body/OrderNumber']}.</p>"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "else": {
            "actions": {
              "Mark_rejected": {
                "type": "OpenApiConnection",
                "runAfter": {},
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PatchItem"
                  },
                  "parameters": {
                    "dataset": "https://contoso.sharepoint.com/sites/Purchasing",
                    "table": "Purchase Requests",
                    "id": "@triggerBody()?['ID']",
                    "item/Title": "@triggerBody()?['Title']",
                    "item/RpaStatus": "@concat('Rejected: ', outputs('Run_desktop_flow')?['body/Errors'])"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              },
              "Tell_requester_rejected": {
                "type": "OpenApiConnection",
                "runAfter": {
                  "Mark_rejected": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                    "connectionName": "shared_office365",
                    "operationId": "SendEmailV2"
                  },
                  "parameters": {
                    "emailMessage/To": "@triggerBody()?['Author']?['Email']",
                    "emailMessage/Subject": "Needs a fix: @{triggerBody()?['Title']}",
                    "emailMessage/Body": "<p>The order was not entered: @{outputs('Run_desktop_flow')?['body/Errors']}</p>"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              }
            }
          }
        },
        "Catch": {
          "type": "Scope",
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          },
          "actions": {
            "Mark_failed": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem"
                },
                "parameters": {
                  "dataset": "https://contoso.sharepoint.com/sites/Purchasing",
                  "table": "Purchase Requests",
                  "id": "@triggerBody()?['ID']",
                  "item/Title": "@triggerBody()?['Title']",
                  "item/RpaStatus": "Failed"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Tell_purchasing_team": {
              "type": "OpenApiConnection",
              "runAfter": {
                "Mark_failed": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2"
                },
                "parameters": {
                  "emailMessage/To": "purchasing-team@contoso.com",
                  "emailMessage/Subject": "RPA failed: @{triggerBody()?['Title']}",
                  "emailMessage/Body": "<p>The desktop flow did not finish: @{coalesce(first(result('Try'))?['error']?['message'], first(result('Try'))?['status'])}</p><p><a href=\"@{triggerBody()?['{Link}']}\">Open the request</a></p>",
                  "emailMessage/Importance": "High"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          }
        },
        "Result": {
          "type": "Compose",
          "inputs": "@coalesce(outputs('Run_desktop_flow')?['body/Status'], 'Failed')",
          "runAfter": {
            "Order_saved": [
              "Succeeded",
              "Skipped"
            ],
            "Catch": [
              "Succeeded",
              "Skipped"
            ]
          }
        }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}
