{
  "name": "mglab-ts-best-practices",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DEVLADLOG Code #1 - TypeScript best practices, built and tested for real",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:6": "tsc6 -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "intake": "node dist/cli.js",
    "demo:errors": "tsc -p demo/tsconfig.json --pretty false",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build",
    "demo:lint": "eslint --no-config-lookup -c demo/eslint.config.mjs demo/lint-me.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
