{
  "name": "contoso-profiling-node",
  "version": "1.0.0",
  "private": true,
  "description": "DEVLADLOG Code #10 - Performance profiling in Node.js: CPU profile, benchmark, event-loop delay, heap. No dependencies.",
  "type": "module",
  "engines": { "node": ">=22" },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "node --check src/cli.js && node --check src/run-report.js",
    "bench": "node src/cli.js bench",
    "profile:slow": "node src/cli.js profile slow",
    "profile:fast": "node src/cli.js profile fast",
    "lag": "node src/cli.js lag",
    "memory": "node --expose-gc src/cli.js memory"
  }
}
