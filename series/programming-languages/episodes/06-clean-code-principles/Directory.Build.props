<Project>
  <!-- Shared by every project in this folder. C# 14 is the default language version for net10.0. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    The clean-code gates. Every project gets them unless it opts out with EnforceCleanCode=false
    (only the legacy baseline does, until it's deleted). Turn them on from the command line with
    dotnet build -p:EnforceCleanCode=true to see what the legacy code would fail on.
  -->
  <ItemGroup Condition="'$(EnforceCleanCode)' != 'false'">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)cleancode.globalconfig" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" />
  </ItemGroup>
</Project>
