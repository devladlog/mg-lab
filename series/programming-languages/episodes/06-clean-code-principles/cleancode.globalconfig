is_global = true

# Small methods: CA1502 cyclomatic complexity. Threshold 10 in CodeMetricsConfig.txt (the default is 25).
# Not enabled by default in .NET 10, so we turn it on.
dotnet_diagnostic.CA1502.severity = warning

# Don't swallow errors: CA1031, do not catch general exception types (not enabled by default either).
dotnet_diagnostic.CA1031.severity = warning

# Braces on every block (IDE0011), so a second line can't silently fall outside the if.
csharp_prefer_braces = true
dotnet_diagnostic.IDE0011.severity = warning

# A value that is assigned and never read is noise or a bug (IDE0059).
dotnet_diagnostic.IDE0059.severity = warning
