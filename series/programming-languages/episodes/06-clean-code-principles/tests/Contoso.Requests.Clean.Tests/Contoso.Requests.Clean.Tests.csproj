<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xUnit test names use underscores; CA1707 is about public API naming, not tests. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../samples/requests.csv" Link="samples/requests.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../golden/legacy-output.approved.txt" Link="golden/legacy-output.approved.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Contoso.Requests.Legacy/Contoso.Requests.Legacy.csproj" />
    <ProjectReference Include="../../src/Contoso.Requests.Clean/Contoso.Requests.Clean.csproj" />
  </ItemGroup>
</Project>
