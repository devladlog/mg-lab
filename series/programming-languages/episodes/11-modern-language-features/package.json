{
  "name": "mglab-modern-language-features",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DEVLADLOG Code #11 - the same request digest in TypeScript (run natively by Node), C#, Python and PowerShell",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/ts/*.test.ts\"",
    "digest": "node src/ts/main.ts samples/requests.json",
    "demo:enum": "node demo/ts/uses-enum.ts",
    "demo:enum-tsc": "tsc -p demo/ts/tsconfig.json --pretty false"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
