{
  "name": "contoso-intake-node",
  "version": "1.0.0",
  "private": true,
  "description": "DEVLADLOG Code #9 - JavaScript and Node.js patterns: streams, bounded concurrency, AbortSignal, retry, promise cache. No dependencies.",
  "type": "module",
  "engines": { "node": ">=22" },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "node --check src/cli.js && node --check demo/gotchas.js",
    "api": "node src/cli.js serve --port 5090 --latency 300",
    "intake": "node src/cli.js intake samples/requests.csv --api http://127.0.0.1:5090",
    "gotchas": "node demo/gotchas.js"
  }
}
