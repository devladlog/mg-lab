{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Requests": "Data Source=requests.db"
  },
  "Notifications": {
    "Channel": "log",
    "StaleAfterDays": 0,
    "DigestInterval": "00:01:00"
  }
}
