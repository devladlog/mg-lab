<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProjectRequests.Perf.Api</RootNamespace>
    <!-- Every JSON type must be in AppJsonContext: anything missing throws instead of silently using reflection. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!-- Pin the 10.0.x line: the 11.0.0 packages on NuGet target net11.0 only (see episode 1 gotcha). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.1" />
  </ItemGroup>

</Project>
