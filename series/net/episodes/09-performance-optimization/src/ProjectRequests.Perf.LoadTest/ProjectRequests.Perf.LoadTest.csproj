<Project Sdk="Microsoft.NET.Sdk">

  <!-- A small, honest load generator: N concurrent workers hit one URL for a fixed time; prints RPS and percentiles. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>loadtest</AssemblyName>
    <RootNamespace>ProjectRequests.Perf.LoadTest</RootNamespace>
  </PropertyGroup>

</Project>
