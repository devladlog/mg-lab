<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BenchmarkDotNet: handles warm-up, iteration counts and allocation measurement. Always run in Release (see the episode README for the exact command).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProjectRequests.Perf.Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ProjectRequests.Perf.Api/ProjectRequests.Perf.Api.csproj" />
  </ItemGroup>

</Project>
