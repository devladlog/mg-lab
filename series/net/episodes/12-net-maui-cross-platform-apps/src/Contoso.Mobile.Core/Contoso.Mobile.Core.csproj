<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything about the app that is NOT UI: models, the API client, the offline outbox, view models.
       Plain net10.0, no MAUI reference: it builds and is tested on any machine, and the MAUI app project references it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
