<?xml version="1.0" encoding="utf-8"?>
<!-- The Android emulator reaches the development machine at 10.0.2.2 (Learn: "Connect to local web services").
     Cleartext HTTP is allowed for that address only. Build action: AndroidResource (set by the SDK for Platforms/Android/Resources). -->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">10.0.2.2</domain>
  </domain-config>
</network-security-config>
