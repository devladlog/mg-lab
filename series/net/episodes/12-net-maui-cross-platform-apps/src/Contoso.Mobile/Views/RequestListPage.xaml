<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Contoso.Mobile.Core.ViewModels;assembly=Contoso.Mobile.Core"
             x:Class="Contoso.Mobile.Views.RequestListPage"
             x:DataType="vm:RequestListViewModel"
             Title="Requests">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="New" Clicked="OnNewClicked" AutomationId="NewRequest" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <!-- The honest status line: offline, server not reachable, or what was just sent. -->
        <Label Grid.Row="0" Text="{Binding Status}" Padding="16,8" AutomationId="StatusLabel"
               BackgroundColor="{AppThemeBinding Light=#E3EEF9, Dark=#10283F}" />

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Rows}" AutomationId="RequestRows">
                <CollectionView.EmptyView>
                    <Label Text="No requests yet. Tap New." Padding="16" HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:RequestRow">
                        <VerticalStackLayout Padding="16,10" Spacing="2">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="17" />
                            <Label Text="{Binding Subtitle}" />
                            <Label Text="{Binding Badge}" TextColor="{StaticResource Primary}" FontSize="13">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding NeedsAttention}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource Warning}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
