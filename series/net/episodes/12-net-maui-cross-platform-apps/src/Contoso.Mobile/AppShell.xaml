<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Contoso.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Contoso.Mobile.Views"
    Title="Contoso Requests">

    <!-- ContentTemplate with a page registered in DI: the page and its view model are built by the container. -->
    <ShellContent
        Title="Requests"
        ContentTemplate="{DataTemplate views:RequestListPage}"
        Route="requests" />

</Shell>
