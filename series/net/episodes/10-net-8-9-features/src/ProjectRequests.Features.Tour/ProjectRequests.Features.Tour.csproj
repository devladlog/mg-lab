<Project Sdk="Microsoft.NET.Sdk">

  <!-- The demo: one console app, run twice (dotnet run -f net8.0, dotnet run -f net10.0). Same source, different features compiled in. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProjectRequests.Features.Tour</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ProjectRequests.Features/ProjectRequests.Features.csproj" />
  </ItemGroup>

</Project>
