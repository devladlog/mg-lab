<Project Sdk="Microsoft.NET.Sdk">

  <!-- Episode 5's xUnit v3 suite (MTP), plus the CORS tests for the Blazor WebAssembly client. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>ProjectRequests.Api.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="ProjectRequests.Api.Tests.TestCancellation" Static="true" />
    <Using Include="ProjectRequests.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ProjectRequests.Api/ProjectRequests.Api.csproj" />
  </ItemGroup>

  <!-- The committed SQL Server script; a test checks it matches the migrations. -->
  <ItemGroup>
    <None Include="../../deploy/sqlserver-migrations.sql" Link="sqlserver-migrations.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
