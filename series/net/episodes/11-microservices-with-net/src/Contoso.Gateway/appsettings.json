{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "System.Net.Http.HttpClient": "Warning", "Yarp": "Information", "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning" } },
  "AllowedHosts": "*",
  "Services": {
    "requests": { "http": [ "localhost:5312" ] },
    "budget": { "http": [ "localhost:5313" ] }
  },
  "ReverseProxy": {
    "Routes": {
      "requests": { "ClusterId": "requests", "Match": { "Path": "/api/requests/{**catch-all}" } },
      "budgets": { "ClusterId": "budget", "Match": { "Path": "/api/budgets/{**catch-all}" } }
    },
    "Clusters": {
      "requests": { "Destinations": { "primary": { "Address": "http://requests/" } } },
      "budget": { "Destinations": { "primary": { "Address": "http://budget/" } } }
    }
  }
}
