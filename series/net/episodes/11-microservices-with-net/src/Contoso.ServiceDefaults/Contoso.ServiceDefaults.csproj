<Project Sdk="Microsoft.NET.Sdk">

  <!-- What every service in this system shares: service discovery, resilient HttpClients, health checks, trace ids in logs.
       The same idea as the Aspire "ServiceDefaults" project, without needing Aspire (or containers) to run. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.1" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.1" />
  </ItemGroup>

</Project>
