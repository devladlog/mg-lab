<Project Sdk="Microsoft.NET.Sdk">

  <!-- xUnit v3 on Microsoft.Testing.Platform, same as episodes 5-8. Every test talks to the REAL services in memory:
       the Requests service calls the real Budget service through its real HttpClient pipeline (retry, circuit breaker). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>   <!-- tests here are in-memory and fast: no cancellation plumbing needed -->
    <RootNamespace>Contoso.Microservices.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Contoso.Budget.Service/Contoso.Budget.Service.csproj" />
    <ProjectReference Include="../../src/Contoso.Requests.Service/Contoso.Requests.Service.csproj" />
    <ProjectReference Include="../../src/Contoso.Gateway/Contoso.Gateway.csproj" />
  </ItemGroup>

</Project>
