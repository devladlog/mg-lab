{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "http://localhost:5207",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://localhost:5208",
        "Protocols": "Http2"
      }
    }
  },
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true
  },
  "ConnectionStrings": {
    "Requests": "Data Source=requests.db"
  },
  "Notifications": {
    "Channel": "log",
    "StaleAfterDays": 0,
    "DigestInterval": "00:01:00"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5180"
    ]
  }
}
