<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Episode 7: the SignalR client side, written once. Used by the Blazor WebAssembly live board (in the browser)
    and by the console watcher. Microsoft.AspNetCore.SignalR.Client runs on .NET and in WebAssembly.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ProjectRequests.Contracts/ProjectRequests.Contracts.csproj" />
  </ItemGroup>

</Project>
