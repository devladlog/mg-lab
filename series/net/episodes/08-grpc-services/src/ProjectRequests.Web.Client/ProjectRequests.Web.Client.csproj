<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Everything in this project is downloaded to the browser and runs on .NET in WebAssembly. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
  </ItemGroup>

  <!-- Same DTOs, validation attributes and PriorityRules as the API: one definition, server and browser. -->
  <ItemGroup>
    <ProjectReference Include="../ProjectRequests.Contracts/ProjectRequests.Contracts.csproj" />
  </ItemGroup>

  <!-- Episode 7: the SignalR client (RequestsFeed), running in the browser for the live board. -->
  <ItemGroup>
    <ProjectReference Include="../ProjectRequests.Feed/ProjectRequests.Feed.csproj" />
  </ItemGroup>

</Project>
