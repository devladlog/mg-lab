<Project Sdk="Microsoft.NET.Sdk">

  <!-- Episode 8: the gRPC client side. A plain .NET console app: generated client + Grpc.Net.Client. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>requests-cli</AssemblyName>
    <RootNamespace>ProjectRequests.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ProjectRequests.Grpc/ProjectRequests.Grpc.csproj" />
  </ItemGroup>

</Project>
