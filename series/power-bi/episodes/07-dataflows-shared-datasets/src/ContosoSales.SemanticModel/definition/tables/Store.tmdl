/// Store dimension (physical stores and the online shop).
table Store

	column StoreKey
		dataType: int64
		isHidden
		isKey
		formatString: 0
		summarizeBy: none
		sourceColumn: StoreKey

	column Store
		dataType: string
		summarizeBy: none
		sourceColumn: Store

	column Country
		dataType: string
		summarizeBy: none
		sourceColumn: Country

	column Channel
		dataType: string
		summarizeBy: none
		sourceColumn: Channel

	partition Store = m
		mode: import
		source =
				let
				    Source = PowerPlatform.Dataflows(null),
				    Workspaces = Source{[Id = "Workspaces"]}[Data],
				    Workspace = Workspaces{[workspaceId = WorkspaceId]}[Data],
				    Dataflow = Workspace{[dataflowId = DataflowId]}[Data],
				    Store = Dataflow{[entity = "Store", version = ""]}[Data]
				in
				    Store
