/// Security mapping for dynamic RLS: one row per user and store they manage. Hidden, not related to any table:
/// the Store Managers role reads it with USERPRINCIPALNAME().
table 'Store Access'
	isHidden

	column 'User Principal Name'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: UserPrincipalName

	column StoreKey
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: StoreKey

	partition 'Store Access' = m
		mode: import
		source =
				let
				    Source = PowerPlatform.Dataflows(null),
				    Workspaces = Source{[Id = "Workspaces"]}[Data],
				    Workspace = Workspaces{[workspaceId = WorkspaceId]}[Data],
				    Dataflow = Workspace{[dataflowId = DataflowId]}[Data],
				    Aliases = Dataflow{[entity = "StoreAccess", version = ""]}[Data],
				    WithUpn = Table.AddColumn(Aliases, "UserPrincipalName", each Text.Lower(Text.Trim([UserAlias]) & "@" & UpnDomain), type text)
				in
				    Table.SelectColumns(WithUpn, {"UserPrincipalName", "StoreKey"})
