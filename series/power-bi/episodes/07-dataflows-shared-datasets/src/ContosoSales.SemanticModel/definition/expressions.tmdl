/// Workspace that holds the dataflow (its ID, from the workspace URL). Set it in the service: semantic model Settings > Parameters, or the Update Parameters REST call.
expression WorkspaceId = "00000000-0000-0000-0000-000000000000" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

/// The dataflow "Contoso Bikes Prep" (its ID, from the dataflow URL). Different in every workspace, which is why it is a parameter.
expression DataflowId = "00000000-0000-0000-0000-000000000000" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

/// Sign-in domain of the users in store_access.csv (the part after @ in their UPN). Set it to your tenant's domain
/// before publishing: Transform data > Edit parameters.
expression UpnDomain = "contoso.com" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
