{
  "name": "pq-lint",
  "version": "1.0.0",
  "description": "pq-lint from episode 3: lints Power Query M files (.pq) with Microsoft's open-source parser; --section parses a whole mashup.pq",
  "private": true,
  "license": "MIT",
  "bin": {
    "pq-lint": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node dist/src/cli.js ../dataflow/queries --strict && node dist/src/cli.js --section ../dataflow/ContosoBikesPrep.Dataflow/mashup.pq"
  },
  "dependencies": {
    "@microsoft/powerquery-parser": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
