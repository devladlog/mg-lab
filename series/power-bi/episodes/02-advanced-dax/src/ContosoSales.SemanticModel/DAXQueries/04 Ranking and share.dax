// Product rank inside its category and share of the category, 2025
EVALUATE
CALCULATETABLE(
    SUMMARIZECOLUMNS(
        'Product'[Category],
        'Product'[Product],
        "Sales", [Sales Amount],
        "Rank", [Product Rank],
        "% of Category", [% of Category]
    ),
    'Date'[Year] = 2025
)
ORDER BY 'Product'[Category], [Rank]
