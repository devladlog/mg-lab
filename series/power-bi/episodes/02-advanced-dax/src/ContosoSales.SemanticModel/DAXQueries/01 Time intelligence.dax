// Every month of 2025: sales, prior year, growth, year to date and the last three months
EVALUATE
CALCULATETABLE(
    SUMMARIZECOLUMNS(
        'Date'[Year Month],
        "Sales", [Sales Amount],
        "Sales PY", [Sales PY],
        "YoY %", [Sales YoY %],
        "Sales YTD", [Sales YTD],
        "Last 3 Months", [Sales Last 3 Months]
    ),
    'Date'[Year] = 2025
)
ORDER BY 'Date'[Year Month]
