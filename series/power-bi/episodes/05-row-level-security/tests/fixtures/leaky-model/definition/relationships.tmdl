relationship 'Sales to Region'
	crossFilteringBehavior: bothDirections
	securityFilteringBehavior: bothDirections
	fromColumn: Sales.RegionKey
	toColumn: Region.RegionKey

relationship 'Sales ship to Region'
	isActive: false
	fromColumn: Sales.ShipRegionKey
	toColumn: Region.RegionKey

relationship 'Sales to Customer'
	crossFilteringBehavior: bothDirections
	securityFilteringBehavior: bothDirections
	fromColumn: Sales.CustomerKey
	toColumn: Customer.CustomerKey

relationship 'Sales to Product'
	fromColumn: Sales.ProductKey
	toColumn: Product.ProductKey

relationship 'Sales to Channel'
	isActive: false
	fromColumn: Sales.ChannelKey
	toColumn: Channel.ChannelKey
