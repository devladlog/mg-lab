/// Date dimension: one row per day, full calendar years, marked as the date table. Filters Sales by order date.
table Date
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Year

	column Quarter
		dataType: string
		summarizeBy: none
		sourceColumn: Quarter

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: "Month Number"

	column Month
		dataType: string
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: 'Month Number'

	column 'Year Month Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: "Year Month Number"

	column 'Year Month'
		dataType: string
		summarizeBy: none
		sourceColumn: "Year Month"
		sortByColumn: 'Year Month Number'

	column 'Day of Week Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: "Day of Week Number"

	column 'Day of Week'
		dataType: string
		summarizeBy: none
		sourceColumn: "Day of Week"
		sortByColumn: 'Day of Week Number'

	hierarchy Calendar

		level Year
			column: Year

		level Quarter
			column: Quarter

		level Month
			column: Month

		level Date
			column: Date

	partition Date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"Date", type date}, {"Year", Int64.Type}, {"Quarter", type text},
				        {"Month Number", Int64.Type}, {"Month", type text},
				        {"Year Month", type text}, {"Year Month Number", Int64.Type},
				        {"Day of Week Number", Int64.Type}, {"Day of Week", type text}
				    }, "en-US")
				in
				    Typed

