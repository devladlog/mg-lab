{
  "name": "Contoso Night Ride",
  "dataColors": ["#4CC2FF", "#FF9F1C", "#FF5D73", "#8A7DFF", "#FFE08A", "#C9D1DC", "#3FD39A", "#F07AD8"],
  "good": "#4CC2FF",
  "neutral": "#FFE08A",
  "bad": "#FF5D73",
  "maximum": "#4CC2FF",
  "center": "#2A3342",
  "minimum": "#FF5D73",
  "background": "#121722",
  "foreground": "#ECEFF4",
  "firstLevelElements": "#ECEFF4",
  "secondLevelElements": "#A3AEBD",
  "thirdLevelElements": "#232B38",
  "fourthLevelElements": "#8B97A8",
  "secondaryBackground": "#2A3342",
  "tableAccent": "#4CC2FF",
  "textClasses": {
    "callout": { "fontSize": 32, "fontFace": "Segoe UI Light", "color": "#4CC2FF" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#ECEFF4" },
    "largeTitle": { "fontSize": 20, "fontFace": "Georgia", "color": "#ECEFF4" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#ECEFF4" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#C9D1DC" },
    "smallLabel": { "fontSize": 9, "fontFace": "Segoe UI", "color": "#A3AEBD" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [{ "show": true, "fontFamily": "Segoe UI Semibold", "fontSize": 12, "fontColor": { "solid": { "color": "#ECEFF4" } }, "alignment": "left" }],
        "subTitle": [{ "show": true, "fontFamily": "Segoe UI", "fontSize": 9, "fontColor": { "solid": { "color": "#A3AEBD" } } }],
        "background": [{ "show": true, "color": { "solid": { "color": "#121722" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#2A3342" } }, "radius": 12, "width": 1 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 12, "bottom": 12, "left": 16, "right": 16 }],
        "visualHeader": [{ "show": true, "foreground": { "solid": { "color": "#A3AEBD" } }, "background": { "solid": { "color": "#121722" } }, "transparency": 0 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0B0F17" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#0B0F17" } }, "transparency": 0 }],
        "outspacePane": [{ "backgroundColor": { "solid": { "color": "#121722" } }, "foregroundColor": { "solid": { "color": "#ECEFF4" } }, "borderColor": { "solid": { "color": "#2A3342" } }, "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#4CC2FF" } }, "fontFamily": "Segoe UI Light", "fontSize": 32 }],
        "categoryLabels": [{ "show": false }],
        "dropShadow": [{ "show": true, "color": { "solid": { "color": "#4CC2FF" } }, "position": "Outer", "preset": "Center", "shadowBlur": 14, "shadowSpread": 0, "shadowDistance": 0, "transparency": 70 }]
      }
    },
    "lineChart": {
      "*": {
        "legend": [{ "show": true, "position": "Top", "labelColor": { "solid": { "color": "#C9D1DC" } }, "fontSize": 9 }],
        "categoryAxis": [{ "gridlineShow": false, "labelColor": { "solid": { "color": "#A3AEBD" } } }],
        "valueAxis": [{ "gridlineShow": true, "gridlineColor": { "solid": { "color": "#2A3342" } }, "gridlineStyle": "dotted", "labelColor": { "solid": { "color": "#A3AEBD" } } }],
        "lineStyles": [{ "strokeWidth": 3, "showMarker": false }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [{ "show": true, "color": { "solid": { "color": "#ECEFF4" } }, "fontSize": 10 }],
        "valueAxis": [{ "show": false, "gridlineShow": false }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#C9D1DC" } }, "fontSize": 10 }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#A3AEBD" } } }],
        "items": [{ "fontColor": { "solid": { "color": "#ECEFF4" } }, "background": { "solid": { "color": "#1B2230" } }, "textSize": 11 }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#232B38" } }, "rowPadding": 4, "textSize": 10 }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#A3AEBD" } }, "backColor": { "solid": { "color": "#121722" } }, "fontFamily": "Segoe UI Semibold" }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#ECEFF4" } }, "backColorPrimary": { "solid": { "color": "#121722" } }, "fontColorSecondary": { "solid": { "color": "#ECEFF4" } }, "backColorSecondary": { "solid": { "color": "#171D29" } } }]
      }
    },
    "textbox": {
      "*": {
        "text": [{ "color": { "solid": { "color": "#ECEFF4" } } }],
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    }
  }
}
