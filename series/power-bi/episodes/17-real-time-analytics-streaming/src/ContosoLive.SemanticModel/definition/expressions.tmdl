/// Query URI of the KQL database (Fabric portal, KQL database, Copy query URI). Never commit the real one.
expression KqlClusterUri = "https://contoso-lab.z0.kusto.fabric.microsoft.com" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

/// Name of the KQL database that holds the materialized view TillEventsUnique.
expression KqlDatabase = "ContosoLive" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
