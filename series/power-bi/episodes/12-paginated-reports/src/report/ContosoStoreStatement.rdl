<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="ContosoSales">
      <ConnectionProperties>
        <DataProvider>OLEDB-MD</DataProvider>
        <ConnectString>Data Source=powerbi://api.powerbi.com/v1.0/myorg/Contoso Sales (Lab);Initial Catalog=ContosoSales</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="StoreSales">
      <Query>
        <DataSourceName>ContosoSales</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Year">
            <Value>=Parameters!Year.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>EVALUATE
SUMMARIZECOLUMNS(
    'Store'[Store],
    'Date'[Month Number],
    'Date'[Month],
    FILTER(VALUES('Date'[Year]), 'Date'[Year] = @Year),
    "Sales Amount", [Sales Amount],
    "Units", [Units],
    "Margin %", [Margin %]
)
ORDER BY 'Store'[Store], 'Date'[Month Number]</CommandText>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/AnalysisServices/QueryDefinition">
            <CommandType>DAX</CommandType>
          </QueryDefinition>
        </rd:DesignerState>
      </Query>
      <Fields>
        <Field Name="Store">
          <DataField>Store[Store]</DataField>
          <rd:TypeName>System.Object</rd:TypeName>
        </Field>
        <Field Name="MonthNumber">
          <DataField>Date[Month Number]</DataField>
          <rd:TypeName>System.Object</rd:TypeName>
        </Field>
        <Field Name="Month">
          <DataField>Date[Month]</DataField>
          <rd:TypeName>System.Object</rd:TypeName>
        </Field>
        <Field Name="SalesAmount">
          <DataField>[Sales Amount]</DataField>
          <rd:TypeName>System.Object</rd:TypeName>
        </Field>
        <Field Name="Units">
          <DataField>[Units]</DataField>
          <rd:TypeName>System.Object</rd:TypeName>
        </Field>
        <Field Name="MarginPct">
          <DataField>[Margin %]</DataField>
          <rd:TypeName>System.Object</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
