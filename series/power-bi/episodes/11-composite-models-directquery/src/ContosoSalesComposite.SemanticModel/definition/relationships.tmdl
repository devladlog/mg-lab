relationship 'Sales to Date'
	fromColumn: Sales.'Order Date'
	toColumn: Date.Date

relationship 'Sales to Customer'
	fromColumn: Sales.CustomerKey
	toColumn: Customer.CustomerKey

relationship 'Sales to Product'
	fromColumn: Sales.ProductKey
	toColumn: Product.ProductKey

relationship 'Sales to Store'
	fromColumn: Sales.StoreKey
	toColumn: Store.StoreKey

relationship 'Sales Agg to Date'
	fromColumn: 'Sales Agg'.'Order Date'
	toColumn: Date.Date

relationship 'Sales Agg to Product'
	fromColumn: 'Sales Agg'.ProductKey
	toColumn: Product.ProductKey

relationship 'Sales Agg to Store'
	fromColumn: 'Sales Agg'.StoreKey
	toColumn: Store.StoreKey
