// HIT. Only measures that are plain SUMs and attributes of the Dual tables Date and Product: the Import table Sales Agg answers.
// SQL Server receives nothing (check sql/06-observe-directquery.sql).
EVALUATE
SUMMARIZECOLUMNS(
    'Date'[Year],
    'Product'[Category],
    "Sales Amount", [Sales Amount],
    "Units", [Units]
)
ORDER BY 'Date'[Year], 'Product'[Category]
