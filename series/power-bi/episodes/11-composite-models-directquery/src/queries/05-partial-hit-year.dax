// PARTIAL. One visual, two measures: [Sales Amount] is answered from Sales Agg, [Orders] needs SQL Server.
// Learn: a calculation is broken into subqueries and each one is checked for an aggregation hit.
EVALUATE
SUMMARIZECOLUMNS(
    'Date'[Year],
    "Sales Amount", [Sales Amount],
    "Orders", [Orders]
)
ORDER BY 'Date'[Year]
