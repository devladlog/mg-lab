<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>tmdl-check</AssemblyName>
    <RootNamespace>MGLab.TmdlCheck</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tabular Object Model (TOM): reads TMDL folders, runs on Linux/macOS/Windows -->
    <PackageReference Include="Microsoft.AnalysisServices" Version="19.120.1" />
  </ItemGroup>

</Project>
