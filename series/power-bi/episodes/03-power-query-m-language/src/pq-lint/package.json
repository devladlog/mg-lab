{
  "name": "pq-lint",
  "version": "1.0.0",
  "description": "Lints Power Query M files (.pq) with Microsoft's open-source Power Query parser",
  "private": true,
  "license": "MIT",
  "bin": { "pq-lint": "dist/src/cli.js" },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test dist/test/*.test.js",
    "lint:episode": "node dist/src/cli.js ../queries --strict"
  },
  "dependencies": {
    "@microsoft/powerquery-parser": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
