/// The hidden table Power BI Desktop adds for every date column while Auto date/time is on (re-created here by hand:
/// Desktop writes it itself). It is a calculated table built with CALENDAR.
table LocalDateTable_OrderDate
	isHidden
	showAsVariationsOnly

	column Date
		dataType: dateTime
		isHidden
		formatString: General Date
		summarizeBy: none
		sourceColumn: [Date]

	column Year
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: [Year]

	partition LocalDateTable_OrderDate = calculated
		mode: import
		source = ADDCOLUMNS(CALENDAR(DATE(2023, 1, 1), DATE(2025, 12, 31)), "Year", YEAR([Date]))
