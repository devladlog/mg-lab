/// Fact table, one row per order line.
table Sales

	/// Sum of the line amount column (a DAX calculated column in the before model, a Power Query column in the after model).
	measure 'Sales Amount' = SUM(Sales[Line Amount])
		formatString: #,0.00
		displayFolder: Base

	measure 'Total Cost' = SUMX(Sales, Sales[Quantity] * Sales[Unit Cost])
		formatString: #,0.00
		displayFolder: Base

	measure Margin = [Sales Amount] - [Total Cost]
		formatString: #,0.00
		displayFolder: Base

	measure 'Margin %' = IFERROR([Margin] / [Sales Amount], 0)
		formatString: 0.0%
		displayFolder: Base

	measure Units = SUM(Sales[Quantity])
		formatString: #,0
		displayFolder: Base

	measure Orders = DISTINCTCOUNT(Sales[Order Number])
		formatString: #,0
		displayFolder: Base

	measure 'Sales PY' = CALCULATE([Sales Amount], SAMEPERIODLASTYEAR('Date'[Date]))
		formatString: #,0.00
		displayFolder: Time intelligence

	measure 'Sales YoY %' =
			DIVIDE(
			    [Sales Amount] - CALCULATE([Sales Amount], SAMEPERIODLASTYEAR('Date'[Date])),
			    CALCULATE([Sales Amount], SAMEPERIODLASTYEAR('Date'[Date]))
			)
		formatString: 0.0%
		displayFolder: Time intelligence

	measure 'Online Sales' = CALCULATE([Sales Amount], FILTER('Store', 'Store'[Channel] = "Online"))
		formatString: #,0.00
		displayFolder: Channels

	column 'Order Number'
		dataType: string
		summarizeBy: none
		sourceColumn: OrderNumber

	column 'Order Timestamp'
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd hh:mm:ss
		summarizeBy: none
		sourceColumn: OrderTimestamp

	column 'Order Date'
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: OrderDate

	column 'Ship Date'
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: ShipDate

	column CustomerKey
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: CustomerKey

	column ProductKey
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: ProductKey

	column StoreKey
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: StoreKey

	column Quantity
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: Quantity

	column 'Unit Price'
		dataType: decimal
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: UnitPrice

	column 'Unit Cost'
		dataType: decimal
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: UnitCost

	column 'Line Ref'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: LineRef

	column Note
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Note

	column 'Line Amount' = Sales[Quantity] * Sales[Unit Price]
		dataType: decimal
		isHidden
		formatString: #,0.00
		summarizeBy: none

	partition Sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\sales_detail.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"OrderNumber", type text}, {"OrderTimestamp", type datetime}, {"ShipDate", type date}, {"CustomerKey", Int64.Type}, {"ProductKey", Int64.Type}, {"StoreKey", Int64.Type}, {"Quantity", Int64.Type}, {"UnitPrice", Currency.Type}, {"UnitCost", Currency.Type}, {"LineRef", type text}, {"Note", type text}}, "en-US"),
				    WithOrderDate = Table.AddColumn(Typed, "OrderDate", each DateTime.Date([OrderTimestamp]), type date)
				in
				    WithOrderDate
