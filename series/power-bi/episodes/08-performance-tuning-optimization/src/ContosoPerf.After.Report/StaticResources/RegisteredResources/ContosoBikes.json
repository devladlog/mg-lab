{
  "name": "Contoso Bikes",
  "dataColors": ["#0B5CAD", "#CC6677", "#7A6A00", "#882255", "#6699CC", "#999933", "#332288", "#44AA99"],
  "good": "#0B5CAD",
  "neutral": "#7A6A00",
  "bad": "#B34700",
  "maximum": "#0B5CAD",
  "center": "#F3F2F1",
  "minimum": "#B34700",
  "background": "#FFFFFF",
  "foreground": "#252423",
  "firstLevelElements": "#252423",
  "secondLevelElements": "#605E5C",
  "thirdLevelElements": "#EDEBE9",
  "fourthLevelElements": "#8A8886",
  "secondaryBackground": "#C8C6C4",
  "tableAccent": "#0B5CAD",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#252423" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#252423" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#252423" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#3B3A39" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [{ "show": true, "fontSize": 12 }],
        "background": [{ "show": true, "transparency": 0 }],
        "border": [{ "show": false }],
        "visualHeader": [{ "show": true }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#FAF9F8" } }, "transparency": 0 }]
      }
    },
    "lineChart": {
      "*": {
        "legend": [{ "show": true, "position": "Top" }],
        "categoryAxis": [{ "gridlineShow": false }]
      }
    }
  }
}
