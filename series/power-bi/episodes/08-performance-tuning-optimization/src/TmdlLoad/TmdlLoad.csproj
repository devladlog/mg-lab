<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>tmdl-load</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tabular Object Model (TOM): the same parser Desktop and the service use for TMDL, on Linux/macOS/Windows -->
    <PackageReference Include="Microsoft.AnalysisServices" Version="19.120.1" />
  </ItemGroup>

</Project>
