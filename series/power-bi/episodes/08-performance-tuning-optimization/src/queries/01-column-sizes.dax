// NEEDS POWER BI DESKTOP (DAX query view). Not run in the build container. Run in Desktop on 21 Nov 2026 (2M lines):
// Sales Line Ref 62.3 MB, Order Timestamp 40.1 MB, Order Number 26.8 MB, Note 10.3 MB, then Customer and Product ~1.1 MB.
// The real size of every column in memory: the dictionary of each column, biggest first.
// INFO.STORAGETABLECOLUMNS needs write permission on the model, so run it in the Desktop file, not over a live connection.
EVALUATE
    SELECTCOLUMNS(
        FILTER(INFO.STORAGETABLECOLUMNS(), [COLUMN_TYPE] = "BASIC_DATA"),
        "Table", [DIMENSION_NAME],
        "Column", [ATTRIBUTE_NAME],
        "Dictionary size", [DICTIONARY_SIZE]
    )
ORDER BY [Dictionary size] DESC
