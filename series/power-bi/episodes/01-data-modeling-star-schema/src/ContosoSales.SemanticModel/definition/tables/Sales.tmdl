/// Fact table, one row per order line. Filters arrive from Date (order date), Customer, Product and Store.
table Sales

	measure 'Sales Amount' = SUMX(Sales, Sales[Quantity] * Sales[Unit Price])
		formatString: #,0.00
		displayFolder: Sales

	measure 'Total Cost' = SUMX(Sales, Sales[Quantity] * Sales[Unit Cost])
		formatString: #,0.00
		displayFolder: Sales

	measure Margin = [Sales Amount] - [Total Cost]
		formatString: #,0.00
		displayFolder: Margin

	measure 'Margin %' = DIVIDE([Margin], [Sales Amount])
		formatString: 0.0%
		displayFolder: Margin

	measure Units = SUM(Sales[Quantity])
		formatString: #,0
		displayFolder: Sales

	measure Orders = DISTINCTCOUNT(Sales[Order Number])
		formatString: #,0
		displayFolder: Sales

	/// Degenerate dimension: kept on the fact table for filtering by order.
	column 'Order Number'
		dataType: string
		summarizeBy: none
		sourceColumn: OrderNumber

	column 'Line Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: LineNumber

	column 'Order Date'
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: OrderDate

	column 'Ship Date'
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: ShipDate

	column CustomerKey
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: CustomerKey

	column ProductKey
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: ProductKey

	column StoreKey
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: StoreKey

	column Quantity
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: Quantity

	column 'Unit Price'
		dataType: decimal
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: UnitPrice

	column 'Unit Cost'
		dataType: decimal
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: UnitCost

	partition Sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_sales.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"OrderNumber", type text}, {"LineNumber", Int64.Type},
				        {"OrderDate", type date}, {"ShipDate", type date},
				        {"CustomerKey", Int64.Type}, {"ProductKey", Int64.Type}, {"StoreKey", Int64.Type},
				        {"Quantity", Int64.Type}, {"UnitPrice", Currency.Type}, {"UnitCost", Currency.Type}
				    }, "en-US")
				in
				    Typed

