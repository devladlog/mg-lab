relationship sales_product
	fromColumn: Sales.ProductKey
	toColumn: Product.ProductKey

relationship product_subcategory
	fromColumn: Product.SubcategoryKey
	toColumn: Subcategory.SubcategoryKey

relationship subcategory_category
	fromColumn: Subcategory.CategoryKey
	toColumn: Category.CategoryKey

relationship sales_customer
	crossFilteringBehavior: bothDirections
	fromColumn: Sales.CustomerKey
	toColumn: Customer.CustomerKey

relationship budget_category
	toCardinality: many
	fromColumn: Budget.CategoryKey
	toColumn: Category.CategoryKey

