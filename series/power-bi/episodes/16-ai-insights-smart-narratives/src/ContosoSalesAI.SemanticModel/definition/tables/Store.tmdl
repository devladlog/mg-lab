/// Store dimension (physical stores and the online shop).
table Store

	column StoreKey
		dataType: int64
		isHidden
		isKey
		formatString: 0
		summarizeBy: none
		sourceColumn: StoreKey

	column Store
		dataType: string
		summarizeBy: none
		sourceColumn: Store

	column Country
		dataType: string
		summarizeBy: none
		sourceColumn: Country

	column Channel
		dataType: string
		summarizeBy: none
		sourceColumn: Channel

	partition Store = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_store.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"StoreKey", Int64.Type}, {"Store", type text}, {"Country", type text}, {"Channel", type text}
				    }, "en-US")
				in
				    Typed

