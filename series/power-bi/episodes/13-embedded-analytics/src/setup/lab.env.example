# Copy the values into the terminal that runs the app (PowerShell: $env:NAME = 'value'). Never commit real values.
PBI_TENANT_ID=00000000-0000-0000-0000-000000000000
PBI_CLIENT_ID=00000000-0000-0000-0000-000000000000
PBI_CLIENT_SECRET=<from New-EmbedServicePrincipal.ps1, shown once>
PBI_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
PBI_REPORT_ID=00000000-0000-0000-0000-000000000000
# The sign-in domain of the lab users (the part after @ in alex.demo@...). Never shown on screen.
PBI_UPN_DOMAIN=contoso.example
# optional: PORT=5173  EMBED_LIFETIME_MINUTES=15
