{
  "EndpointName": "Contoso.AppOps",
  "Targets": ["CON-SRV01"],
  "LogDirectory": "C:\\OpsJob\\logs",
  "Retry": { "MaxAttempts": 3, "BaseDelaySeconds": 5, "MaxDelaySeconds": 60 },
  "Policy": {
    "RestartAllowed": ["W3SVC", "WAS"],
    "MaxRestartsPer24h": 3,
    "MaxLogFolderMB": 50,
    "LogRetentionDays": 14,
    "CriticalFreePercent": 10,
    "MaxUptimeDays": 35
  }
}
