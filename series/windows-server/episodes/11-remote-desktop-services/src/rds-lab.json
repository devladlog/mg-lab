{
  "SchemaVersion": 1,
  "Deployment": {
    "ConnectionBroker": "con-rds01.lab.contoso.com",
    "WebAccess": "con-rds01.lab.contoso.com",
    "SessionHosts": [ "con-rds01.lab.contoso.com" ],
    "LicenseServer": "con-rds01.lab.contoso.com"
  },
  "Collection": {
    "Name": "MG Lab Desktops",
    "Description": "Lab session desktops (episode 11)",
    "UserGroup": [ "CONTOSO\\RDS Demo Users" ]
  },
  "Policy": {
    "LicensingMode": "PerUser",
    "GraceWarnDays": 30,
    "CertMinDays": 30,
    "RequireTrustedCertificates": true,
    "RequireNla": true,
    "SecurityLayer": "SSL",
    "EncryptionLevel": "High",
    "IdleSessionLimitMin": 30,
    "DisconnectedSessionLimitMin": 60,
    "ActiveSessionLimitMin": 0,
    "AutomaticReconnectionEnabled": true,
    "TemporaryFoldersDeletedOnExit": true
  }
}
