{
  "SchemaVersion": 1,
  "Policy": {
    "MaxCoreSystemDriveUsedGB": 16,
    "RequirePinnedImageTag": true
  },
  "DesktopOnlyFeatures": [
    "Web-Mgmt-Console", "Web-Lgcy-Mgmt-Console", "RDS-Gateway", "RDS-RD-Server", "RDS-Web-Access",
    "Hyper-V-Tools", "PowerShell-ISE", "Windows-Defender-Gui", "XPS-Viewer", "Search-Service", "Wireless-Networking",
    "RSAT-ADCS", "RSAT-ADCS-Mgmt", "RSAT-Online-Responder", "RSAT-ADRMS", "RSAT-Fax", "RSAT-File-Services",
    "RSAT-DFS-Mgmt-Con", "RSAT-FSRM-Mgmt", "RSAT-NFS-Admin", "RSAT-NPAS", "RSAT-Print-Services", "RSAT-VA-Tools",
    "RSAT-NLB", "RSAT-SNMP", "RSAT-WINS", "WDS-AdminPack", "UpdateServices-UI", "SMTP-Server", "Simple-TCPIP",
    "TFTP-Client", "WebDAV-Redirector", "Biometric-Framework", "Windows-Identity-Foundation"
  ],
  "Targets": [
    { "Name": "CON-DC01",  "Role": "Domain controller",  "ExpectedInstall": "Core",              "AppCompat": "No" },
