    { "Name": "CON-SRV02", "Role": "Admin console",      "ExpectedInstall": "DesktopExperience", "AppCompat": "No", "Reason": "runs the graphical consoles (RSAT, certtmpl.msc, Hyper-V Manager) for the whole lab" },
    { "Name": "CON-SQL01", "Role": "Database server",    "ExpectedInstall": "Core",              "AppCompat": "No" },
    { "Name": "CON-CLI01", "Role": "Test client",        "ExpectedInstall": "Core",              "AppCompat": "No" }
  ],
  "Setup": {
    "AppCompatCapability": "ServerCore.AppCompatibility~~~~0.0.1.0",
    "FodSourcePath": ""
  }
}
