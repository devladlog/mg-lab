# escape=`
# Sample for the tests: the same image, fixed. Invented, not built.
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish -c Release -o /out

FROM mcr.microsoft.com/windows/nanoserver:ltsc2025 AS runtime
WORKDIR /app
COPY --from=build /out .
RUN cmd /c echo ok `
    > C:\app\ready.txt
ENTRYPOINT ["dotnet", "Contoso.Api.dll"]
