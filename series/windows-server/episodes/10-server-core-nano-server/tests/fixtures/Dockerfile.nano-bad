# Sample for the tests: a Contoso API image. Invented, not built.
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish -c Release -o /out

FROM mcr.microsoft.com/windows/nanoserver AS runtime
SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop';"]
WORKDIR /app
COPY --from=build /out .
RUN powershell -Command Set-Content -Path C:\app\ready.txt -Value ok
ENTRYPOINT ["dotnet", "Contoso.Api.dll"]
