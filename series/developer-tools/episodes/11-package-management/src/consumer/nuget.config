<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Project-scoped Azure Artifacts feed. ORGANIZATION and PROJECT are replaced when the demo is set up
         (demo.md); the feed name is the one the orders pipeline publishes to. -->
    <add key="contoso-packages" value="https://pkgs.dev.azure.com/ORGANIZATION/PROJECT/_packaging/contoso-packages/nuget/v3/index.json" />
  </packageSources>

  <!-- Contoso.* only from our feed, everything else from nuget.org. Without this section NuGet asks every
       source and a same-named package on the public source can win (dependency confusion). -->
  <packageSourceMapping>
    <packageSource key="contoso-packages">
      <package pattern="Contoso.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
</configuration>
