<Project Sdk="Microsoft.NET.Sdk">

  <!-- The one project in this repository that is published as a NuGet package (to Azure Artifacts, see
       azure-pipelines.yml). Other teams' clients take it as a PackageReference instead of copying the DTOs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Contoso.Orders.Contracts</RootNamespace>

    <PackageId>Contoso.Orders.Contracts</PackageId>
    <!-- Stable version comes from here; the pipeline adds -ci.<build id> (VersionSuffix) outside main. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Contoso Orders team</Authors>
    <Description>Request and response types and validation rules of the Contoso orders API.</Description>
    <PackageTags>contoso;orders;contracts</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Same bytes from the same source, so a rebuilt package can be compared with the published one. -->
    <ContinuousIntegrationBuild Condition="'$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
