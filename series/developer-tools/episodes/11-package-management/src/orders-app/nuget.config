<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Only what is listed here, never the user-level or machine-level sources. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!-- Every package, direct or transitive, must match a pattern. One source, so one pattern; the consumer repo
       (consumer/nuget.config) is where two sources make the mapping matter. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- Where restore asks for vulnerability data. -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>

  <config>
    <!-- A packages folder per repository: source mapping is not applied to a package that is already in the
         global packages folder, so a shared ~/.nuget/packages can hide a wrong mapping. -->
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
</configuration>
