{
	// Shown to everyone who opens this folder: "This workspace has extension recommendations."
	// Ids are always publisher.name. Keep the list short: what this repo needs, not personal favourites.
	"recommendations": [
		"editorconfig.editorconfig",
		"dbaeumer.vscode-eslint",
		"esbenp.prettier-vscode",
		"ms-python.python",
		"ms-dotnettools.csdevkit",
		"ms-azuretools.vscode-bicep",
		"github.vscode-github-actions",
	],
	// Never suggested here. Recommendations don't block installs; extensions.allowed (policy) does.
	"unwantedRecommendations": [
		"ms-vscode.vscode-typescript-tslint-plugin", // TSLint is replaced by ESLint in this repo
	],
}
