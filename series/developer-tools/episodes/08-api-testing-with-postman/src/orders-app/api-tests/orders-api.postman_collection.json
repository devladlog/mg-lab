{
  "info": {
    "_postman_id": "00000000-0000-0000-0000-000000000000",
    "name": "Contoso Orders API",
    "description": "Tests for the Contoso orders API (episode 8). Run it with `scripts/run-api-tests.sh` or Newman; see the episode README.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET healthz",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"healthz: 200 and JSON\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "pm.test(\"healthz: the body has the documented shape\", () => {",
                  "  pm.response.to.have.jsonSchema({",
                  "    type: \"object\",",
                  "    required: [\"status\", \"version\", \"database\", \"dotnet\", \"inContainer\"],",
                  "    properties: { status: { type: \"string\" }, version: { type: \"string\", minLength: 1 },",
                  "                  database: { type: \"string\" }, inContainer: { type: \"boolean\" } }",
                  "  });",
                  "});",
                  "pm.test(\"healthz: status is ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));",
                  "// After a deploy the pipeline sets expectedVersion to the commit it just built (episode 5): done = live.",
                  "const expected = pm.environment.get(\"expectedVersion\");",
                  "if (expected) {",
                  "  pm.test(\"healthz: version is the one just deployed\", () => pm.expect(pm.response.json().version).to.eql(expected));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": "Liveness plus the shape of /healthz. When the environment variable expectedVersion is set, the reported version must match it."
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create order",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A unique customer per run, so a failure can be traced to one run. {{$randomInt}} is a Postman dynamic variable.",
                  "pm.collectionVariables.set(\"customer\", \"Alex Demo \" + pm.variables.replaceIn(\"{{$randomInt}}\"));",
                  "pm.collectionVariables.set(\"total\", 42.5);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sent = { customer: pm.collectionVariables.get(\"customer\"), total: Number(pm.collectionVariables.get(\"total\")) };",
                  "pm.test(\"create: 201 Created\", () => pm.response.to.have.status(201));",
                  "const order = pm.response.json();",
                  "pm.test(\"create: the body is an order (strict schema)\", () => {",
                  "  pm.response.to.have.jsonSchema(JSON.parse(pm.collectionVariables.get(\"orderSchema\")));",
                  "});",
                  "pm.test(\"create: it echoes what we sent\", () => {",
                  "  pm.expect(order.customer).to.eql(sent.customer);",
                  "  pm.expect(order.total).to.eql(sent.total);",
                  "});",
                  "pm.test(\"create: Location points at the new order\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/orders/\" + order.id);",
                  "});",
                  "// Chain: the next requests read this order back.",
                  "pm.collectionVariables.set(\"orderId\", order.id);",
                  "pm.collectionVariables.set(\"createdOrder\", JSON.stringify(order));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": \"{{customer}}\",\n  \"total\": {{total}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Read the order back",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"read: 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"read: identical to what create returned\", () => {",
                  "  pm.expect(pm.response.json()).to.eql(JSON.parse(pm.collectionVariables.get(\"createdOrder\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            }
          }
        },
        {
          "name": "List orders: first page",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"list: 200\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test(\"list: the body is a page of orders (strict schema)\", () => {",
                  "  const order = JSON.parse(pm.collectionVariables.get(\"orderSchema\"));",
                  "  pm.response.to.have.jsonSchema({",
                  "    type: \"object\", additionalProperties: false,",
                  "    required: [\"pageNumber\", \"pageSize\", \"total\", \"items\", \"totalPages\"],",
                  "    properties: {",
                  "      pageNumber: { type: \"integer\", minimum: 1 }, pageSize: { type: \"integer\", minimum: 1, maximum: 100 },",
                  "      total: { type: \"integer\", minimum: 0 }, totalPages: { type: \"integer\", minimum: 0 },",
                  "      items: { type: \"array\", items: order }",
                  "    }",
                  "  });",
                  "});",
                  "pm.test(\"list: defaults to page 1 of 50\", () => {",
                  "  pm.expect(page.pageNumber).to.eql(1);",
                  "  pm.expect(page.pageSize).to.eql(50);",
                  "  pm.expect(page.items.length).to.eql(Math.min(50, page.total));",
                  "});",
                  "pm.test(\"list: totalPages is consistent with total and pageSize\", () => {",
                  "  pm.expect(page.totalPages).to.eql(Math.ceil(page.total / page.pageSize));",
                  "});",
                  "pm.test(\"list: sorted by id, ascending\", () => {",
                  "  const ids = page.items.map(o => o.id);",
                  "  pm.expect(ids).to.eql([...ids].sort((a, b) => a - b));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "List orders: page size is capped",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"cap: 200\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test(\"cap: asking for 500 returns at most 100\", () => {",
                  "  pm.expect(page.pageSize).to.eql(100);",
                  "  pm.expect(page.items.length).to.eql(Math.min(100, page.total));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders?pageSize=500",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ],
              "query": [
                {
                  "key": "pageSize",
                  "value": "500"
                }
              ]
            }
          }
        },
        {
          "name": "Order not found",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"not found: 404 with an empty body\", () => {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.text()).to.eql(\"\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/2147483647",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "2147483647"
              ]
            }
          }
        },
        {
          "name": "Order id is not a number",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"not numeric: the :int route constraint gives 404, not 500\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/abc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "abc"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Validation",
      "item": [
        {
          "name": "Rejected: page 0",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"page 0: 400 as application/problem+json\", () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "});",
                  "const problem = pm.response.json();",
                  "pm.test(\"page 0: the body is a validation problem (strict schema)\", () => {",
                  "  pm.response.to.have.jsonSchema({",
                  "    type: \"object\", required: [\"title\", \"status\", \"errors\"],",
                  "    properties: { status: { const: 400 }, title: { type: \"string\" },",
                  "      errors: { type: \"object\", minProperties: 1, additionalProperties: { type: \"array\", minItems: 1, items: { type: \"string\" } } } }",
                  "  });",
                  "});",
                  "pm.test(\"page 0: the error names the field\", () => pm.expect(problem.errors).to.have.property(\"page\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders?page=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "Rejected: body is not JSON",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"not json: 400, not 500\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{ this is not json",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Data-driven",
      "item": [
        {
          "name": "Rejected: invalid order (data file)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const field = pm.iterationData.get(\"expectedField\");",
                  "const label = \"[\" + pm.iterationData.get(\"case\") + \"]\";",
                  "pm.test(\"invalid order \" + label + \": data file row is present\", () => pm.expect(field, \"run with -d data/invalid-orders.json\").to.be.a(\"string\"));",
                  "pm.test(\"invalid order \" + label + \": 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"invalid order \" + label + \": the error is about \" + field, () => {",
                  "  pm.expect(pm.response.json().errors).to.have.property(field);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {{badCustomer}},\n  \"total\": {{badTotal}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Needs iteration data: newman run ... --folder Data-driven -d data/invalid-orders.json. One iteration per row. Values are JSON literals, so null, \"\" and numbers can all be sent."
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level test: runs after every request in the collection.",
          "const limit = Number(pm.environment.get(\"maxResponseMs\") || 2000);",
          "// With a data file the same request runs once per row: the iteration number keeps the names unique.",
          "const run = pm.info.iterationCount > 1 ? \" [iteration \" + (pm.info.iteration + 1) + \"]\" : \"\";",
          "pm.test(pm.info.requestName + run + \": answered within \" + limit + \" ms\", () => {",
          "  pm.expect(pm.response.responseTime).to.be.below(limit);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "orderSchema",
      "type": "string",
      "value": "{\"type\":\"object\",\"required\":[\"id\",\"customer\",\"total\",\"created\"],\"additionalProperties\":false,\"properties\":{\"id\":{\"type\":\"integer\",\"minimum\":1},\"customer\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":100},\"total\":{\"type\":\"number\",\"exclusiveMinimum\":0},\"created\":{\"type\":\"string\",\"pattern\":\"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\"}}}"
    },
    {
      "key": "orderId",
      "type": "string",
      "value": ""
    },
    {
      "key": "createdOrder",
      "type": "string",
      "value": ""
    }
  ]
}
