<Project>
  <!-- Applies to every project in the repo. -->
  <PropertyGroup>
    <!-- packages.lock.json next to each project: the exact package graph is committed. CI restores in locked
         mode (RestoreLockedMode, see the workflow) and fails instead of silently resolving something new.
         The lock files are also the cache key for actions/setup-dotnet (cache: true). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
