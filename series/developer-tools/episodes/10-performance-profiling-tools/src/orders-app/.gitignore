# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
# .NET
bin/
obj/
# Node
node_modules/
# Secrets and local settings never go in Git
.env
*.pfx
local.settings.json
# Editors / OS
.vs/
.DS_Store
# Local SQLite database (dotnet run outside a container)
*.db
*.db-shm
*.db-wal


# Diagnostics output (traces hold method names and timings, dumps would hold memory: never commit them)
*.dmp

# Profiling output
profile/
*.nettrace
*.speedscope.json
