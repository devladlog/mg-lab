<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Log scope around the selection</Title>
      <Author>Contoso Orders team</Author>
      <Description>Wraps the selected statements in a logging scope named after the step (Edit, IntelliSense, Surround With).</Description>
      <Shortcut>ordscope</Shortcut>
      <SnippetTypes>
        <SnippetType>SurroundsWith</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>step</ID>
          <ToolTip>Name of the step, shown in every log line inside the scope</ToolTip>
          <Default>health-check</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp"><![CDATA[using (_log.BeginScope("$step$"))
        {
            $selected$
        }
        $end$]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
