{
	// Episode 2's basics
	"editor.formatOnSave": true,
	"files.insertFinalNewline": true,
	"files.trimTrailingWhitespace": true,
	"files.eol": "\n",

	// C#: the C# extension formats with the rules in .editorconfig, the same ones `dotnet format` checks in CI
	"[csharp]": { "editor.defaultFormatter": "ms-dotnettools.csharp" },

	// Python: Ruff formats and fixes on save, with ruff.toml from the repo root (the ruff-vscode README example)
	"[python]": {
		"editor.formatOnSave": true,
		"editor.codeActionsOnSave": {
			"source.fixAll": "explicit",
			"source.organizeImports": "explicit",
		},
		"editor.defaultFormatter": "charliermarsh.ruff",
	},
}
