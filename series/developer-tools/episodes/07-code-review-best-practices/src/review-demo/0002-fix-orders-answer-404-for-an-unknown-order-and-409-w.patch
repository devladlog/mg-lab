From b30314766d3f19de80679cd298f1b22c5d87f607 Mon Sep 17 00:00:00 2001
From: Alex Demo <alex.demo@contoso.example>
Date: Wed, 4 Nov 2026 08:40:00 +0000
Subject: [PATCH 2/2] fix(orders): answer 404 for an unknown order and 409 when
 cancelling twice

Review feedback: no null-forgiving operator, status values in one place, tests for the unhappy paths.
---
 src/Contoso.Orders.Api/Orders.cs              |  9 ++++-
 src/Contoso.Orders.Api/Program.cs             |  7 ++--
 tests/Contoso.Orders.Api.Tests/CancelTests.cs | 36 ++++++++++++++++---
 3 files changed, 44 insertions(+), 8 deletions(-)

diff --git a/src/Contoso.Orders.Api/Orders.cs b/src/Contoso.Orders.Api/Orders.cs
index 9fbfc1c..79bc6fc 100644
--- a/src/Contoso.Orders.Api/Orders.cs
+++ b/src/Contoso.Orders.Api/Orders.cs
@@ -9,7 +9,14 @@ public sealed class Order
     [MaxLength(100)] public required string Customer { get; set; }
     public decimal Total { get; set; }
     public DateOnly Created { get; set; }
-    public string Status { get; set; } = "open";
+    public string Status { get; set; } = OrderStatus.Open;
+}
+
+/// <summary>The values Order.Status can have. Strings on purpose: they are what the API returns.</summary>
+public static class OrderStatus
+{
+    public const string Open = "open";
+    public const string Cancelled = "cancelled";
 }
 
 public sealed record NewOrder(string? Customer, decimal Total);
diff --git a/src/Contoso.Orders.Api/Program.cs b/src/Contoso.Orders.Api/Program.cs
index ce4d276..e275787 100644
--- a/src/Contoso.Orders.Api/Program.cs
+++ b/src/Contoso.Orders.Api/Program.cs
@@ -51,8 +51,11 @@ app.MapPost("/orders", async (NewOrder input, OrdersDb db) =>
 
 app.MapPost("/orders/{id:int}/cancel", async (int id, OrdersDb db) =>
 {
-    var order = await db.Orders.FindAsync(id);
-    order!.Status = "cancelled";
+    if (await db.Orders.FindAsync(id) is not { } order) return Results.NotFound();
+    // Cancelling twice is a conflict, not a silent success: the caller's picture of the order is wrong.
+    if (order.Status == OrderStatus.Cancelled)
+        return Results.Problem(statusCode: StatusCodes.Status409Conflict, title: "The order is already cancelled");
+    order.Status = OrderStatus.Cancelled;
     await db.SaveChangesAsync();
     return Results.Ok(order);
 });
diff --git a/tests/Contoso.Orders.Api.Tests/CancelTests.cs b/tests/Contoso.Orders.Api.Tests/CancelTests.cs
index de8acea..d4d22f5 100644
--- a/tests/Contoso.Orders.Api.Tests/CancelTests.cs
+++ b/tests/Contoso.Orders.Api.Tests/CancelTests.cs
@@ -1,5 +1,6 @@
 using System.Net;
 using System.Net.Http.Json;
+using System.Text.Json;
 using Contoso.Orders.Api;
 
 namespace Contoso.Orders.Api.Tests;
@@ -8,15 +9,40 @@ public class CancelTests(ApiFactory factory) : IClassFixture<ApiFactory>
 {
     private readonly HttpClient _client = factory.CreateClient();
 
+    private async Task<Order> CreateOrderAsync() =>
+        (await (await _client.PostAsJsonAsync("/orders", new NewOrder("Alex Demo", 10m)))
+            .Content.ReadFromJsonAsync<Order>())!;
+
     [Fact]
-    public async Task Cancel_marks_the_order_cancelled()
+    public async Task Cancel_marks_the_order_cancelled_and_it_stays_cancelled()
     {
-        var created = await (await _client.PostAsJsonAsync("/orders", new NewOrder("Alex Demo", 10m)))
-            .Content.ReadFromJsonAsync<Order>();
+        var created = await CreateOrderAsync();
+        Assert.Equal(OrderStatus.Open, created.Status);
 
-        var response = await _client.PostAsync($"/orders/{created!.Id}/cancel", content: null);
+        var response = await _client.PostAsync($"/orders/{created.Id}/cancel", content: null);
 
         Assert.Equal(HttpStatusCode.OK, response.StatusCode);
-        Assert.Equal("cancelled", (await response.Content.ReadFromJsonAsync<Order>())!.Status);
+        Assert.Equal(OrderStatus.Cancelled, (await response.Content.ReadFromJsonAsync<Order>())!.Status);
+        Assert.Equal(OrderStatus.Cancelled, (await _client.GetFromJsonAsync<Order>($"/orders/{created.Id}"))!.Status);
+    }
+
+    [Fact]
+    public async Task Cancelling_an_unknown_order_is_404_not_500()
+    {
+        var response = await _client.PostAsync("/orders/2147483647/cancel", content: null);
+        Assert.Equal(HttpStatusCode.NotFound, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Cancelling_twice_is_a_409_with_a_reason()
+    {
+        var created = await CreateOrderAsync();
+        Assert.Equal(HttpStatusCode.OK, (await _client.PostAsync($"/orders/{created.Id}/cancel", content: null)).StatusCode);
+
+        var again = await _client.PostAsync($"/orders/{created.Id}/cancel", content: null);
+
+        Assert.Equal(HttpStatusCode.Conflict, again.StatusCode);
+        var problem = await again.Content.ReadFromJsonAsync<JsonElement>();
+        Assert.Equal("The order is already cancelled", problem.GetProperty("title").GetString());
     }
 }
-- 
