# Normalise line endings in the repo; check out text files with the platform default...
* text=auto
# ...except files that must stay LF everywhere: hooks and shell scripts break with CRLF
.githooks/* text eol=lf
*.sh        text eol=lf
*.py        text eol=lf
# Never diff or merge these as text
*.png binary
*.jpg binary
*.zip binary
