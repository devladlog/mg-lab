{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "mg_sharedsharepointonline_loans"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "mg_sharedoffice365_loans"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_teams": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "mg_sharedteams_loans"
        },
        "api": {
          "name": "shared_teams"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "ReminderCc": {
          "type": "String",
          "defaultValue": ""
        },
        "OpsEmail": {
          "type": "String",
          "defaultValue": ""
        }
      },
      "triggers": {
        "Every_weekday_at_8": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Week",
            "interval": 1,
            "schedule": {
              "weekDays": [
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday"
              ],
              "hours": [
                "8"
              ],
              "minutes": [
                0
              ]
            },
            "timeZone": "GMT Standard Time"
          }
        }
      },
      "actions": {
        "Try": {
          "type": "Scope",
          "runAfter": {},
          "actions": {
            "Get_overdue_loans": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "https://contoso.sharepoint.example/sites/Facilities",
                  "table": "Equipment loans",
                  "$filter": "Status eq 'Out' and DueDate lt '@{utcNow('yyyy-MM-dd')}'",
                  "$top": 200
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Apply_to_each": {
              "type": "Foreach",
              "foreach": "@body('Get_overdue_loans')?['value']",
              "runAfter": {
                "Get_overdue_loans": [
                  "Succeeded"
                ]
              },
              "actions": {
                "Send_reminder": {
                  "type": "OpenApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                      "connectionName": "shared_office365",
                      "operationId": "SendEmailV2"
                    },
                    "parameters": {
                      "emailMessage/To": "@items('Apply_to_each')?['BorrowerEmail']",
                      "emailMessage/Cc": "@parameters('ReminderCc')",
                      "emailMessage/Subject": "Overdue: @{items('Apply_to_each')?['Title']}",
                      "emailMessage/Body": "<p>Please return it. It was due on @{formatDateTime(items('Apply_to_each')?['DueDate'], 'dd-MM-yyyy')}.</p>"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              }
            },
            "Post_summary": {
              "type": "OpenApiConnection",
              "runAfter": {
                "Apply_to_each": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                  "connectionName": "shared_teams",
                  "operationId": "PostMessageToConversation"
                },
                "parameters": {
                  "poster": "Flow bot",
                  "location": "Channel",
                  "body/recipient/groupId": "00000000-0000-0000-0000-000000000000",
                  "body/recipient/channelId": "19:00000000000000000000000000000000@thread.tacv2",
                  "body/messageBody": "<p>@{length(body('Get_overdue_loans')?['value'])} equipment loans are overdue.</p>"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          }
        },
        "Catch": {
          "type": "Scope",
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          },
          "actions": {
            "Send_failure_notice": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2"
                },
                "parameters": {
                  "emailMessage/To": "@parameters('OpsEmail')",
                  "emailMessage/Subject": "Loan reminders failed",
                  "emailMessage/Body": "<p>The run @{workflow()?['run']?['name']} failed.</p>"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          }
        }
      }
    }
  }
}
