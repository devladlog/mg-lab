{
  "_comment": "What the formulas of the Contoso equipment-loan app may name. Tables and controls are listed by hand because the standalone Power Fx engine cannot see the app.",
  "tables": {
    "Loans": {
      "datasource": true,
      "columns": {
        "Item": "string",
        "Borrower": "string",
        "BorrowerEmail": "string",
        "DueDate": "date",
        "ReturnedOn": "date",
        "Status": "string"
      }
    }
  },
  "controls": {
    "txtSearch": { "fields": { "Text": "string" } },
    "galLoans": { "fields": { "Selected": { "record": "Loans" } } }
  },
  "variables": {
    "varToday": "date"
  }
}
