<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Contoso.VendorDesk</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.PowerFx.Core" Version="1.8.1" />
    <PackageReference Include="Microsoft.PowerFx.Interpreter" Version="1.8.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- The formulas are plain text files: the same text is pasted into Copilot Studio. -->
    <Content Include="rules\*.fx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
