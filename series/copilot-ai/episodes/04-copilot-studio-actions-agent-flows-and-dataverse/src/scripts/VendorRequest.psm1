<#
  VendorRequest.psm1 - the Dataverse side of the Contoso Vendor Desk agent.

  Table "Vendor Request" (mgl_vendorrequest), created through the Dataverse Web API, and a read-back function to show
  the row that the agent flow wrote. Shapes follow Microsoft Learn:
    Create and update table definitions using the Web API
    Create and update column definitions using the Web API
    Create autonumber columns
  Needs the tenant (a Dataverse environment and an access token). Nothing is stored; the token is a parameter
  (a SecureString or a string). Learn's documented way to get one, with no app registration of your own:
    Connect-AzAccount
    $token = Get-AzAccessToken -ResourceUrl 'https://<org>.crm4.dynamics.com' -AsSecureString   # .Token
#>
Set-StrictMode -Version Latest

$script:Prefix      = 'mgl'
$script:Table       = 'mgl_vendorrequest'       # logical name
$script:EntitySet   = 'mgl_vendorrequests'      # Web API collection name
$script:Lcid        = 1033
$script:ApiVersion  = 'v9.2'
$script:Odata       = 'Microsoft.Dynamics.CRM.'

$script:Categories  = [ordered]@{ Hosting = 727000000; Printing = 727000001; Travel = 727000002; Security = 727000003; Other = 727000004 }
$script:Statuses    = [ordered]@{ Submitted = 727000000; Approved = 727000001; Rejected = 727000002 }

function New-Label([string]$Text) {
    @{
        '@odata.type'   = "$($script:Odata)Label"
        LocalizedLabels = @(@{ '@odata.type' = "$($script:Odata)LocalizedLabel"; Label = $Text; LanguageCode = $script:Lcid })
    }
}

function New-Required([string]$Level = 'None') {
    @{ Value = $Level; CanBeChanged = $true; ManagedPropertyLogicalName = 'canmodifyrequirementlevelsettings' }
}

function New-ChoiceColumn([string]$Schema, [string]$Display, $Options, [string]$Description) {
    @{
        '@odata.type'     = "$($script:Odata)PicklistAttributeMetadata"
        AttributeType     = 'Picklist'
        AttributeTypeName = @{ Value = 'PicklistType' }
        SchemaName        = $Schema
        DisplayName       = New-Label $Display
        Description       = New-Label $Description
        RequiredLevel     = New-Required 'ApplicationRequired'
        OptionSet         = @{
            '@odata.type' = "$($script:Odata)OptionSetMetadata"
            IsGlobal      = $false
            OptionSetType = 'Picklist'
            Options       = @($Options.GetEnumerator() | ForEach-Object { @{ Value = [int]$_.Value; Label = New-Label $_.Key } })
        }
    }
}

function Get-VendorRequestTableDefinition {
    <# EntityMetadata for POST /EntityDefinitions. The primary name column is an autonumber (VR-0001, VR-0002...)
       so the agent never has to invent a request number. #>
    [CmdletBinding()] param()
    @{
        '@odata.type'          = "$($script:Odata)EntityMetadata"
        SchemaName             = 'mgl_VendorRequest'
        DisplayName            = New-Label 'Vendor Request'
        DisplayCollectionName  = New-Label 'Vendor Requests'
        Description            = New-Label 'A request to onboard a new vendor, filed through the Vendor Desk agent.'
        OwnershipType          = 'UserOwned'
        IsActivity             = $false
        HasActivities          = $false
        HasNotes               = $true
        Attributes             = @(
            @{
                '@odata.type'      = "$($script:Odata)StringAttributeMetadata"
                AttributeType      = 'String'
                AttributeTypeName  = @{ Value = 'StringType' }
                SchemaName         = 'mgl_RequestNumber'
                DisplayName        = New-Label 'Request Number'
                Description        = New-Label 'Generated by Dataverse: VR-0001, VR-0002, ...'
                RequiredLevel      = New-Required 'None'
                MaxLength          = 100
                FormatName         = @{ Value = 'Text' }
                AutoNumberFormat   = 'VR-{SEQNUM:4}'
                IsPrimaryName      = $true
            }
        )
    }
}

function Get-VendorRequestColumnDefinitions {
    <# AttributeMetadata bodies for POST /EntityDefinitions(LogicalName='mgl_vendorrequest')/Attributes. #>
    [CmdletBinding()] param()
    @(
        @{
            '@odata.type'     = "$($script:Odata)StringAttributeMetadata"
            AttributeType     = 'String'
            AttributeTypeName = @{ Value = 'StringType' }
            SchemaName        = 'mgl_VendorName'
            DisplayName       = New-Label 'Vendor Name'
            Description       = New-Label 'Legal or trading name of the vendor.'
            RequiredLevel     = New-Required 'ApplicationRequired'
            MaxLength         = 200
            FormatName        = @{ Value = 'Text' }
        }
        (New-ChoiceColumn 'mgl_Category' 'Category' $script:Categories 'Hosting, printing, travel, security or other.')
        @{
            '@odata.type'     = "$($script:Odata)MoneyAttributeMetadata"
            AttributeType     = 'Money'
            AttributeTypeName = @{ Value = 'MoneyType' }
            SchemaName        = 'mgl_EstimatedAnnualCost'
            DisplayName       = New-Label 'Estimated Annual Cost'
            Description       = New-Label 'Estimated yearly cost of the vendor, in the record currency (euros).'
            RequiredLevel     = New-Required 'ApplicationRequired'
            PrecisionSource   = 2
            MinValue          = 0
        }
        @{
            '@odata.type'     = "$($script:Odata)MemoAttributeMetadata"
            AttributeType     = 'Memo'
            AttributeTypeName = @{ Value = 'MemoType' }
            SchemaName        = 'mgl_Justification'
            DisplayName       = New-Label 'Justification'
            Description       = New-Label 'Why the business needs this vendor.'
            RequiredLevel     = New-Required 'None'
            Format            = 'TextArea'
            MaxLength         = 2000
        }
        @{
            '@odata.type'     = "$($script:Odata)StringAttributeMetadata"
            AttributeType     = 'String'
            AttributeTypeName = @{ Value = 'StringType' }
            SchemaName        = 'mgl_ApprovalTier'
            DisplayName       = New-Label 'Approval Tier'
            Description       = New-Label 'Who must approve, from the Vendor Onboarding Policy.'
            RequiredLevel     = New-Required 'None'
            MaxLength         = 100
            FormatName        = @{ Value = 'Text' }
        }
        (New-ChoiceColumn 'mgl_Status' 'Status' $script:Statuses 'Submitted, approved or rejected.')
    )
}

function Test-OrgUrl([string]$OrgUrl) {
    if ($OrgUrl -notmatch '^https://[a-z0-9-]+\.crm\d{0,2}\.dynamics\.com/?$') {
        throw "OrgUrl must look like https://<org>.crm4.dynamics.com (got '$OrgUrl')."
    }
}

function ConvertTo-PlainToken($Token) {
    if ($Token -is [securestring]) { return ($Token | ConvertFrom-SecureString -AsPlainText) }
    if ($Token -and $Token.PSObject.Properties['Token']) { return (ConvertTo-PlainToken $Token.Token) }  # Get-AzAccessToken result
    "$Token"
}

function Invoke-Dataverse {
    <# One place for headers, so the tests can assert them. Returns the Invoke-RestMethod result. #>
    [CmdletBinding()]
    param([string]$OrgUrl, $AccessToken, [ValidateSet('GET', 'POST', 'DELETE')][string]$Method, [string]$Path,
          $Body, [hashtable]$ExtraHeaders = @{})
    Test-OrgUrl $OrgUrl
    $headers = @{
        Authorization      = "Bearer $(ConvertTo-PlainToken $AccessToken)"
        Accept             = 'application/json'
        'OData-MaxVersion' = '4.0'
        'OData-Version'    = '4.0'
    }
    foreach ($k in $ExtraHeaders.Keys) { $headers[$k] = $ExtraHeaders[$k] }
    $p = @{
        Uri     = ($OrgUrl.TrimEnd('/') + "/api/data/$($script:ApiVersion)/" + $Path)
        Method  = $Method
        Headers = $headers
    }
    if ($null -ne $Body) { $p.Body = ($Body | ConvertTo-Json -Depth 20); $p.ContentType = 'application/json; charset=utf-8' }
    Invoke-RestMethod @p
}

function Install-VendorRequestTable {
    <# Creates the table and its columns inside the solution. Idempotent: skips a table that already exists. #>
    [CmdletBinding(SupportsShouldProcess = $true)]
    param(
        [Parameter(Mandatory)][string]$OrgUrl,
        [Parameter(Mandatory)]$AccessToken,
        [Parameter(Mandatory)][ValidatePattern('^[A-Za-z][A-Za-z0-9_]*$')][string]$SolutionUniqueName
    )
    $sol = @{ 'MSCRM.SolutionUniqueName' = $SolutionUniqueName }
    $exists = $true
    try {
        Invoke-Dataverse -OrgUrl $OrgUrl -AccessToken $AccessToken -Method GET `
            -Path "EntityDefinitions(LogicalName='$($script:Table)')?`$select=LogicalName" | Out-Null
    } catch {
        if ("$($_.Exception.Message)" -match '404|Not Found|does not exist') { $exists = $false } else { throw }
    }
    if ($exists) { Write-Host "Table $($script:Table) already exists: nothing to do."; return }

    if ($PSCmdlet.ShouldProcess($script:Table, 'Create table')) {
        Invoke-Dataverse -OrgUrl $OrgUrl -AccessToken $AccessToken -Method POST -Path 'EntityDefinitions' `
            -Body (Get-VendorRequestTableDefinition) -ExtraHeaders $sol | Out-Null
    }
    foreach ($col in Get-VendorRequestColumnDefinitions) {
        if ($PSCmdlet.ShouldProcess("$($script:Table).$($col.SchemaName)", 'Create column')) {
            Invoke-Dataverse -OrgUrl $OrgUrl -AccessToken $AccessToken -Method POST `
                -Path "EntityDefinitions(LogicalName='$($script:Table)')/Attributes" -Body $col -ExtraHeaders $sol | Out-Null
        }
    }
    Write-Host "Created $($script:Table) with $((Get-VendorRequestColumnDefinitions).Count) columns in solution $SolutionUniqueName."
}

function ConvertTo-ODataString([string]$Value) { "'" + $Value.Replace("'", "''") + "'" }

function Get-VendorRequest {
    <# Reads the newest rows, with the formatted (label) values of the choice and money columns. #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$OrgUrl,
        [Parameter(Mandatory)]$AccessToken,
        [ValidateRange(1, 100)][int]$Top = 5,
        [ValidatePattern('^VR-\d{4,}$')][string]$RequestNumber
    )
    $q = @("`$select=mgl_requestnumber,mgl_vendorname,mgl_category,mgl_estimatedannualcost,mgl_approvaltier,mgl_status,createdon",
           "`$orderby=createdon desc", "`$top=$Top")
    if ($RequestNumber) { $q += "`$filter=mgl_requestnumber eq $(ConvertTo-ODataString $RequestNumber)" }
    $r = Invoke-Dataverse -OrgUrl $OrgUrl -AccessToken $AccessToken -Method GET `
        -Path ("$($script:EntitySet)?" + ($q -join '&')) `
        -ExtraHeaders @{ Prefer = 'odata.include-annotations="OData.Community.Display.V1.FormattedValue"' }
    $fv = 'OData.Community.Display.V1.FormattedValue'
    foreach ($row in @($r.value)) {
        [pscustomobject]@{
            RequestNumber = $row.mgl_requestnumber
            Vendor        = $row.mgl_vendorname
            Category      = $row."mgl_category@$fv"
            AnnualCost    = $row."mgl_estimatedannualcost@$fv"
            ApprovalTier  = $row.mgl_approvaltier
            Status        = $row."mgl_status@$fv"
            Created       = $row.createdon
        }
    }
}

function Remove-VendorRequestTable {
    <# Tear-down: deletes the table (and every row in it). #>
    [CmdletBinding(SupportsShouldProcess = $true, ConfirmImpact = 'High')]
    param([Parameter(Mandatory)][string]$OrgUrl, [Parameter(Mandatory)]$AccessToken)
    if ($PSCmdlet.ShouldProcess($script:Table, 'Delete table and all rows')) {
        Invoke-Dataverse -OrgUrl $OrgUrl -AccessToken $AccessToken -Method DELETE `
            -Path "EntityDefinitions(LogicalName='$($script:Table)')" | Out-Null
    }
}

Export-ModuleMember -Function Get-VendorRequestTableDefinition, Get-VendorRequestColumnDefinitions, Install-VendorRequestTable,
                              Get-VendorRequest, Remove-VendorRequestTable, ConvertTo-ODataString
