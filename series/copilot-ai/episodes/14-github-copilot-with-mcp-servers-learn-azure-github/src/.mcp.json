{
  "mcpServers": {
    "microsoftLearn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp",
      "tools": [
        "*"
      ]
    },
    "azure": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@4.0.0-beta.9",
        "server",
        "start",
        "--read-only"
      ],
      "tools": [
        "*"
      ]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "tools": [
        "*"
      ]
    },
    "contosoVendors": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-m",
        "vendor_mcp"
      ],
      "tools": [
        "*"
      ]
    }
  }
}
