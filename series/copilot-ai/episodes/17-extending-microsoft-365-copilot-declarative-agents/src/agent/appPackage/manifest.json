{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "1.0.0",
  "id": "${{APP_ID}}",
  "developer": {
    "name": "Contoso Vendor Management Office",
    "websiteUrl": "https://www.contoso.example",
    "privacyUrl": "https://www.contoso.example/privacy",
    "termsOfUseUrl": "https://www.contoso.example/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Vendor Desk",
    "full": "Contoso Vendor Desk"
  },
  "description": {
    "short": "Vendor renewals and decision deadlines from the Contoso VMO register.",
    "full": "Ask which vendor contracts renew next, who must decide and by when, and set a decision reminder. Uses the Contoso vendor renewals API (fictional demo data)."
  },
  "accentColor": "#1F4E79",
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "vendorDesk",
        "file": "declarativeAgent.json"
      }
    ]
  }
}
