{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "${vendorName}",
      "weight": "Bolder",
      "size": "Medium"
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Renewal", "value": "${renewalDate}" },
        { "title": "Decide by", "value": "${decideBy}" },
        { "title": "Owner", "value": "${owner}" },
        { "title": "Yearly cost (EUR)", "value": "${annualCostEur}" },
        { "title": "Status", "value": "${status}" }
      ]
    }
  ]
}
